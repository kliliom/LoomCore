#! /bin/bash

set -e

# Set working directory to the repository root
cd "${0%/*}/.."

# Lint with the same config split as .bin/format: the DocC bundle uses its own
# configuration, everything else uses the repository default.
find Sources Tests -name '*.swift' -not -path '*/Documentation.docc/*' -print0 \
  | xargs -0 swift format lint --strict --parallel
swift format lint --strict --parallel --recursive \
  --configuration .swift-format-docs Sources/LoomCore/Documentation.docc
