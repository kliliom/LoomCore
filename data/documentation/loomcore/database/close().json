{"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Closes the SQLite connection and finalizes every cached prepared statement."}],"metadata":{"symbolKind":"method","modules":[{"name":"LoomCore"}],"title":"close()","role":"symbol","roleHeading":"Instance Method","externalID":"s:8LoomCore8DatabaseC5closeyyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"close","kind":"identifier"},{"text":"()","kind":"text"}]},"hierarchy":{"paths":[["doc:\/\/LoomCore\/documentation\/LoomCore","doc:\/\/LoomCore\/documentation\/LoomCore\/Database"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/close()","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/DatabaseActor","preciseIdentifier":"s:8LoomCore13DatabaseActorC","text":"DatabaseActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"close","kind":"identifier"},{"text":"()","kind":"text"}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Use this when deterministic resource release is required rather than relying on","type":"text"},{"text":" ","type":"text"},{"text":"deallocation timing — for example, before deleting the underlying database file","type":"text"},{"text":" ","type":"text"},{"text":"or when running large numbers of short-lived connections in tests. Any subsequent","type":"text"},{"text":" ","type":"text"},{"text":"operation on this database will throw.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Deliberately synchronous and exempt from transaction gating, so it can serve as an","type":"text"},{"text":" ","type":"text"},{"text":"escape hatch for a stuck transaction: closing the connection makes the transaction’s","type":"text"},{"text":" ","type":"text"},{"text":"remaining statements — and any waiting operations — fail with ","type":"text"},{"code":".databaseClosed","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Statements in flight when ","type":"text"},{"code":"close()","type":"codeVoice"},{"text":" runs keep working — an iteration in progress","type":"text"},{"text":" ","type":"text"},{"text":"continues to completion — and the connection is fully released once their handles","type":"text"},{"text":" ","type":"text"},{"text":"are destroyed. Only new operations throw.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let tempURL = URL(fileURLWithPath: \"\/tmp\/scratch.sqlite\")","let db = try await Database.open(url: tempURL)","defer { Task { @DatabaseActor in db.close() } }","try await db.exec(\"CREATE TABLE scratch (id INTEGER PRIMARY KEY)\")"]}]}],"variants":[{"paths":["\/documentation\/loomcore\/database\/close()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://LoomCore/documentation/LoomCore/Database/close()":{"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"close","kind":"identifier"},{"text":"()","kind":"text"}],"abstract":[{"type":"text","text":"Closes the SQLite connection and finalizes every cached prepared statement."}],"url":"\/documentation\/loomcore\/database\/close()","title":"close()","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/close()","kind":"symbol","role":"symbol"},"doc://LoomCore/documentation/LoomCore/DatabaseActor":{"navigatorTitle":[{"kind":"identifier","text":"DatabaseActor"}],"url":"\/documentation\/loomcore\/databaseactor","abstract":[{"text":"Global actor that serializes all SQLite access in LoomCore.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"te