{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/execScript(_:)"},"sections":[],"hierarchy":{"paths":[["doc:\/\/LoomCore\/documentation\/LoomCore","doc:\/\/LoomCore\/documentation\/LoomCore\/Database"]]},"abstract":[{"text":"Executes every statement in a multi-statement SQL script, in order.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/loomcore\/database\/execscript(_:)"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/DatabaseActor","preciseIdentifier":"s:8LoomCore13DatabaseActorC","kind":"attribute","text":"DatabaseActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"execScript"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"script"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"script","content":[{"inlineContent":[{"type":"text","text":"One or more SQL statements separated by "},{"code":";","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"code":"exec","type":"codeVoice"},{"type":"text","text":" and "},{"code":"query","type":"codeVoice"},{"type":"text","text":" families prepare exactly one statement and throw"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/LoomCoreErrorCode\/trailingSQL"},{"type":"text","text":" when handed more. Use this for migration and schema"},{"type":"text","text":" "},{"type":"text","text":"scripts:"}],"type":"paragraph"},{"syntax":"swift","code":["try await db.execScript(","  \"\"\"","  CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT);","  CREATE UNIQUE INDEX idx_users_name ON users (name);","  \"\"\"",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Statements take no bound parameters (a "},{"code":"?","type":"codeVoice"},{"type":"text","text":" or named placeholder throws"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/LoomCoreErrorCode\/invalidScript"},{"type":"text","text":") and are never cached. Rows produced by a statement"},{"type":"text","text":" "},{"type":"text","text":"are stepped through and discarded. A failure part-way leaves earlier statements applied —"},{"type":"text","text":" "},{"type":"text","text":"wrap the call in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/transaction(kind:_:)"},{"type":"text","text":" for all-or-nothing application."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A script may manage its own transaction as long as it is balanced — "},{"code":"BEGIN … COMMIT","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"pairs (what "},{"code":"sqlite3 .dump","type":"codeVoice"},{"type":"text","text":" emits) run atomically because the whole script executes"},{"type":"text","text":" "},{"type":"text","text":"synchronously while holding the gate. A script that "},{"inlineContent":[{"type":"text","text":"leaves"}],"type":"emphasis"},{"type":"text","text":" a transaction open is"},{"type":"text","text":" "},{"type":"text","text":"rolled back and throws "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/LoomCoreErrorCode\/invalidScript"},{"type":"text","text":": the gate is released when"},{"type":"text","text":" "},{"type":"text","text":"this call returns, so an open transaction would swallow other tasks’ writes with"},{"type":"text","text":" "},{"type":"text","text":"nothing left to commit them. Inside "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/transaction(kind:_:)"},{"type":"text","text":", a script"},{"type":"text","text":" "},{"type":"text","text":"statement that ends the enclosing transaction throws the same error. A script-managed"},{"type":"text","text":" "},{"type":"text","text":"transaction fires no "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/Service"},{"type":"text","text":" lifecycle hooks — when registered services"},{"type":"text","text":" "},{"type":"text","text":"must observe the commit, run the script inside "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/transaction(kind:_:)"},{"type":"text","text":" "},{"type":"text","text":"instead."}],"type":"paragraph"},{"style":"warning","name":"Warning","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Never build a script from user input — it bypasses parameter binding entirely."}],"type":"paragraph"}]}]}],"metadata":{"symbolKind":"method","role":"symbol","roleHeading":"Instance Method","externalID":"s:8LoomCore8DatabaseC10execScriptyySSYaKF","extendedModule":"LoomCore","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"execScript"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"title":"execScript(_:)","modules":[{"name":"LoomCore"}]},"kind":"symbol","references":{"doc://LoomCore/documentation/LoomCore/LoomC