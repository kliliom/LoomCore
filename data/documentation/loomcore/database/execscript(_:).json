{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"DatabaseActor","preciseIdentifier":"s:8LoomCore13DatabaseActorC","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/DatabaseActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"execScript"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"script"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"script","content":[{"inlineContent":[{"type":"text","text":"One or more SQL statements separated by "},{"type":"codeVoice","code":";"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"exec"},{"type":"text","text":" and "},{"code":"query","type":"codeVoice"},{"type":"text","text":" families prepare exactly one statement and throw"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/LoomCoreErrorCode\/trailingSQL"},{"type":"text","text":" when handed more. Use this for migration and schema"},{"type":"text","text":" "},{"type":"text","text":"scripts:"}]},{"syntax":"swift","code":["try await db.execScript(","  \"\"\"","  CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT);","  CREATE UNIQUE INDEX idx_users_name ON users (name);","  \"\"\"",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Statements take no bound parameters (a "},{"type":"codeVoice","code":"?"},{"type":"text","text":" or named placeholder throws"},{"type":"text","text":" "},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/LoomCoreErrorCode\/invalidScript","isActive":true,"type":"reference"},{"text":") and are never cached. Rows produced by a statement","type":"text"},{"text":" ","type":"text"},{"text":"are stepped through and discarded. A failure part-way leaves earlier statements applied —","type":"text"},{"type":"text","text":" "},{"type":"text","text":"wrap the call in "},{"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/transaction(kind:_:)","isActive":true},{"type":"text","text":" for all-or-nothing application."}]},{"inlineContent":[{"type":"text","text":"A script may manage its own transaction as long as it is balanced — "},{"type":"codeVoice","code":"BEGIN … COMMIT"},{"type":"text","text":" "},{"type":"text","text":"pairs (what "},{"code":"sqlite3 .dump","type":"codeVoice"},{"type":"text","text":" emits) run atomically because the whole script executes"},{"type":"text","text":" "},{"type":"text","text":"synchronously while holding the gate. A script that "},{"type":"emphasis","inlineContent":[{"type":"text","text":"leaves"}]},{"type":"text","text":" a transaction open is"},{"type":"text","text":" "},{"type":"text","text":"rolled back and throws "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/LoomCoreErrorCode\/invalidScript"},{"type":"text","text":": the gate is released when"},{"type":"text","text":" "},{"type":"text","text":"this call returns, so an open transaction would swallow other tasks’ writes with"},{"type":"text","text":" "},{"type":"text","text":"nothing left to commit them. Inside "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/transaction(kind:_:)"},{"type":"text","text":", a script"},{"type":"text","text":" "},{"type":"text","text":"statement that ends the enclosing transaction throws the same error. A script-managed"},{"type":"text","text":" "},{"type":"text","text":"transaction fires no "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/Service"},{"type":"text","text":" lifecycle hooks — when registered services"},{"type":"text","text":" "},{"type":"text","text":"must observe the commit, run the script inside "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/transaction(kind:_:)"},{"type":"text","text":" "},{"type":"text","text":"instead."}],"type":"paragraph"},{"style":"warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Never build a script from user input — it bypasses parameter binding entirely."}]}],"type":"aside","name":"Warning"}]}],"abstract":[{"type":"text","text":"Executes every statement in a multi-statement SQL script, in order."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/loomcore\/database\/execscript(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/execScript(_:)","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Instance Method","extendedModule":"LoomCore","externalID":"s:8LoomCore8DatabaseC10execScriptyySSYaKF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"execScript","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"role":"symbol","title":"execScript(_:)","symbolKind":"method","modules":[{"name":"LoomCore"}]},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/LoomCore\/documentation\/LoomCore","doc:\/\/LoomCore\/documentation\/LoomCore\/Database"]]},"references":{"doc://LoomCore/documentation/LoomCore/Datab