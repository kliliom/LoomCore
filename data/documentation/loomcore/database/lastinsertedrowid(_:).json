{"metadata":{"externalID":"s:8LoomCore8DatabaseC17lastInsertedRowIDys5Int64VSgyyYaYbKAA0C5ActorCYcXEYaKF","roleHeading":"Instance Method","modules":[{"name":"LoomCore"}],"extendedModule":"LoomCore","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lastInsertedRowID"},{"kind":"text","text":"(() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:s4Voida","kind":"typeIdentifier","text":"Void"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:s5Int64V","kind":"typeIdentifier","text":"Int64"},{"kind":"text","text":"?"}],"title":"lastInsertedRowID(_:)","role":"symbol","symbolKind":"method"},"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/loomcore\/database\/lastinsertedrowid(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"type":"text","text":"Captures the ROWID of the last row inserted by the given block."}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"DatabaseActor","preciseIdentifier":"s:8LoomCore13DatabaseActorC","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/DatabaseActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lastInsertedRowID"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"block"},{"kind":"text","text":": @"},{"kind":"typeIdentifier","text":"DatabaseActor","preciseIdentifier":"s:8LoomCore13DatabaseActorC","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/DatabaseActor"},{"kind":"text","text":" "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Int64","preciseIdentifier":"s:s5Int64V"},{"kind":"text","text":"?"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"ROWID of the last insert, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if none occurred or the target table"},{"type":"text","text":" "},{"type":"text","text":"does not generate ROWIDs."}]}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Resets SQLite’s last-insert ROWID to 0 before running "},{"code":"block","type":"codeVoice"},{"type":"text","text":", so the returned value"},{"type":"text","text":" "},{"type":"text","text":"only reflects inserts performed inside the closure. For tables with an"},{"type":"text","text":" "},{"code":"INTEGER PRIMARY KEY","type":"codeVoice"},{"type":"text","text":", the ROWID is that primary key; for other rowid tables, SQLite"},{"type":"text","text":" "},{"type":"text","text":"assigns one automatically. "},{"code":"WITHOUT ROWID","type":"codeVoice"},{"type":"text","text":" tables do not generate a ROWID."}]},{"syntax":"swift","type":"codeListing","code":["let userID = try await db.lastInsertedRowID {","  try await db.exec(raw: \"INSERT INTO users (name, email) VALUES (?, ?)\", binding: \"Alice\", \"a@example.com\")","  try await db.exec(raw: \"INSERT INTO audit_log (action, user) VALUES (?, ?)\", binding: \"create\", \"Alice\")","}","\/\/ userID is the ROWID of the audit_log insert — the last one in the block."]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the block performs multiple inserts, only the final insert’s ROWID is returned."},{"type":"text","text":" "},{"type":"text","text":"Wrap each insert in its own call to track them individually."}]},{"inlineContent":[{"type":"text","text":"If the block suspends outside a transaction, a concurrent task’s insert can land"},{"type":"text","text":" "},{"type":"text","text":"between the block’s inserts and clobber the captured ROWID. Wrap the call in"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/transaction(kind:_:)"},{"type":"text","text":" when the value must be reliable."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/LoomCore\/documentation\/LoomCore","doc:\/\/LoomCore\/documentation\/LoomCore\/Database"]]},"identifier":{"url":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/lastInsertedRowID(_:)","interfaceLanguage":"swift"},"references":{"doc://LoomCore/documentation/LoomCore/Database":{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database","navigatorTitle":[{"text":"Database","kind":"identifier"}],"abstract":[{"text":"SQLite database connection serialized through ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/DatabaseActor","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Database","kind":"identifier"}],"title":"Database","url":"\/documentation\/loomcore\/database","kind":"symbol"},"doc://LoomCore/documentation/LoomCore/Database/transaction(kind:_:)":{"type":"topic","title":"transaction(kind:_:)","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"transaction"},{"kind":"text"