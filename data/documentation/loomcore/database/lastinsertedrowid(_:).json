\")","  try await db.exec(raw: \"INSERT INTO audit_log (action, user) VALUES (?, ?)\", binding: \"create\", \"Alice\")","}","\/\/ userID is the ROWID of the audit_log insert — the last one in the block."]},{"type":"paragraph","inlineContent":[{"text":"When the block performs multiple inserts, only the final insert’s ROWID is returned.","type":"text"},{"text":" ","type":"text"},{"text":"Wrap each insert in its own call to track them individually.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the block suspends outside a transaction, a concurrent task’s insert can land","type":"text"},{"text":" ","type":"text"},{"text":"between the block’s inserts and clobber the captured ROWID. Wrap the call in","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/transaction(kind:_:)","type":"reference"},{"text":" when the value must be reliable.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/loomcore\/database\/lastinsertedrowid(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://LoomCore/documentation/LoomCore/Database/transaction(kind:_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"transaction"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8LoomCore15TransactionKindO","kind":"typeIdentifier","text":"TransactionKind"},{"kind":"text","text":", ("},{"preciseIdentifier":"s:8LoomCore8DatabaseC","kind":"typeIdentifier","text":"Database"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"text":"T","kind":"typeIdentifier"},{"kind":"text","text":") "},{"text":"async","kind":"keyword"},{"kind":"text","text":" "},{"text":"throws","kind":"keyword"},{"kind":"text","tex