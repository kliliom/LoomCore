t":" () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"T"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"SQLite parses and optimizes SQL on first preparation. Inside a "},{"type":"codeVoice","code":"cached"},{"type":"text","text":" block, statements"},{"type":"text","text":" "},{"type":"text","text":"prepared for the first time are retained in the database’s statement cache and reused on"},{"type":"text","text":" "},{"type":"text","text":"subsequent calls with the same SQL — turning per-call preparation into a one-time cost"},{"type":"text","text":" "},{"type":"text","text":"for tight loops and batch operations."}]},{"syntax":"swift","code":["let pendingLogs = [(message: \"started\", level: 1), (message: \"finished\", level: 2)]","try await db.cached {","  for entry in pendingLogs {","    try await db.exec(","      raw: \"INSERT INTO logs (message, level) VALUES (?, ?)\",","      binding: entry.message, entry.level","    )","  }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Caching applies to both "},{"type":"codeVoice","code":"exec"},{"type":"text","text":" and "},{"type":"codeVoice","code":"query"},{"type":"text","text":":"}]},{"syntax":"swift","code":["let names = try await db.cached {","  try await db.query(\"SELECT name FROM users WHERE active = 1\") { stmt, index, _ in","    try String.column(of: stmt, at: &index)","  }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Caching is scoped to the current task tree, so concurrent tasks running database work"},{"type":"text","text":" "},{"type":"text","text":"outside the block are unaffected."}]},{"level":2,"type":"heading","text":"Lifetime","anchor":"Lifetime"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cached statements are not finalized when the block exits — the cache lives on the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Database"},{"type":"text","text":", so a second "},{"type":"codeVoice","code":"cached"},{"type":"text","text":" block reuses statements prepared by the first. It is"},{"type":"text","text":" "},{"type":"text","text":"bounded by the "},{"type":"codeVoice","code":"statementCacheCapacity"},{"type":"text","text":" set at "},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/open(url:statementCacheCapacity:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"(128 by default): at capacity, the least-recently-used statement is finalized to make"},{"type":"text","text":" "},{"type":"text","text":"room, so hot-loop statements stay resident while one-off SQL cycles out. Call"},{"type":"text","text":" "},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/clearStatementCache()","type":"reference","isActive":true},{"type":"text","text":" to release the cache eagerly. Nested "},{"type":"codeVoice","code":"cached"},{"type":"text","text":" calls share"},{"type":"text","text":" "},{"type":"text","text":"the existing scope and do not enable caching twice."}]}]}],"abstract":[{"type":"text","text":"Enables prepared statement caching for the duration of "},{"code":"block","type":"codeVoice"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/LoomCore\/documentation\/LoomCore","doc:\/\/LoomCore\/documentation\/LoomCore\/Database"]]},"kind":"symbol","references":{"doc://LoomCore/documentation/LoomCore/Database/cached(_:)":{"url":"\/documentation\/loomcore\/database\/cached(_:)","role":"symbol","title":"cached(_:)","type":"topic","identifier":"doc:\/\