{"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/loomcore\/database\/cached(_:)"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:8LoomCore13DatabaseActorC","text":"DatabaseActor","kind":"attribute","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/DatabaseActor"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cached","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"block","kind":"internalParam"},{"text":": @","kind":"text"},{"preciseIdentifier":"s:8LoomCore13DatabaseActorC","text":"DatabaseActor","kind":"typeIdentifier","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/DatabaseActor"},{"text":" ","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"T","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"SQLite parses and optimizes SQL on first preparation. Inside a ","type":"text"},{"code":"cached","type":"codeVoice"},{"text":" block, statements","type":"text"},{"text":" ","type":"text"},{"text":"prepared for the first time are retained in the database’s statement cache and reused on","type":"text"},{"text":" ","type":"text"},{"text":"subsequent calls with the same SQL — turning per-call preparation into a one-time cost","type":"text"},{"text":" ","type":"text"},{"text":"for tight loops and batch operations.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let pendingLogs = [(message: \"started\", level: 1), (message: \"finished\", level: 2)]","try await db.cached {","  for entry in pendingLogs {","    try await db.exec(","      raw: \"INSERT INTO logs (message, level) VALUES (?, ?)\",","      binding: entry.message, entry.level","    )","  }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Caching applies to both ","type":"text"},{"code":"exec","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"query","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let names = try await db.cached {","  try await db.query(\"SELECT name FROM users WHERE active = 1\") { stmt, index, _ in","    try String.column(of: stmt, at: &index)","  }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Caching is scoped to the current task tree, so concurrent tasks running database work","type":"text"},{"text":" ","type":"text"},{"text":"outside the block are unaffected.","type":"text"}],"type":"paragraph"},{"text":"Lifetime","level":2,"anchor":"Lifetime","type":"heading"},{"inlineContent":[{"text":"Cached statements are not finalized when the block exits — the cache lives on the","type":"text"},{"text":" ","type":"text"},{"code":"Database","type":"codeVoice"},{"text":", so a second ","type":"text"},{"code":"cached","type":"codeVoice"},{"text":" block reuses statements prepared by the first. It is","type":"text"},{"text":" ","type":"text"},{"text":"bounded by the ","type":"text"},{"code":"statementCacheCapacity","type":"codeVoice"},{"text":" set at ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/open(url:statementCacheCapacity:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"(128 by default): at capacity, the least-recently-used statement is finalized to make","type":"text"},{"text":" ","type":"text"},{"text":"room, so hot-loop statements stay resident while one-off SQL cycles out. Call","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/clearStatementCache()","isActive":true,"type":"reference"},{"text":" to release the cache eagerly. Nested ","type":"text"},{"code":"cached","type":"codeVoice"},{"text":" calls share","type":"text"},{"text":" ","type":"text"},{"text":"the existing scope and do not enable caching twice.","type":"text"}],"type":"paragraph"}]}],"metadata":{"modules":[{"name":"LoomCore"}],"role":"symbol","roleHeading":"Instance Method","title":"cached(_:)","externalID":"s:8LoomCore8DatabaseC6cachedyxxyYaYbKAA0C5ActorCYcXEYaKlF","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cached","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"T","kind":"typeIdentifier"}],"extendedModule":"LoomCore"},"abstract":[{"text":"Enables prepared statement caching for the duration of ","type":"text"},{"code":"block","type":"codeVoice"},{"text":".","type":"text"}],"hierarchy":{"paths":[["doc:\/\/LoomCore\/documentation\/LoomCore","doc:\/\/LoomCore\/documentation\/LoomCore\/Database"]]},"identifier":{"url":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/cached(_:)","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://LoomCore/documentation/LoomCore/Database/cached(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cached","kind":"identifier"},{"text":"<","kind"