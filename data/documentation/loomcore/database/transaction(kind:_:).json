{"metadata":{"roleHeading":"Instance Method","extendedModule":"LoomCore","externalID":"s:8LoomCore8DatabaseC11transaction4kind_xAA15TransactionKindO_xACYaYbKAA0C5ActorCYcXEtYaKlF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transaction","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8LoomCore15TransactionKindO","text":"TransactionKind","kind":"typeIdentifier"},{"text":", (","kind":"text"},{"preciseIdentifier":"s:8LoomCore8DatabaseC","text":"Database","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"T","kind":"typeIdentifier"}],"role":"symbol","title":"transaction(kind:_:)","symbolKind":"method","modules":[{"name":"LoomCore"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/transaction(kind:_:)"},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"DatabaseActor","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/DatabaseActor","kind":"attribute","preciseIdentifier":"s:8LoomCore13DatabaseActorC"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transaction","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TransactionKind","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/TransactionKind","kind":"typeIdentifier","preciseIdentifier":"s:8LoomCore15TransactionKindO"},{"text":" = .deferred, ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"block","kind":"internalParam"},{"text":": @","kind":"text"},{"text":"DatabaseActor","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/DatabaseActor","kind":"typeIdentifier","preciseIdentifier":"s:8LoomCore13DatabaseActorC"},{"text":" ","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" (","kind":"text"},{"text":"Database","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database","kind":"typeIdentifier","preciseIdentifier":"s:8LoomCore8DatabaseC"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"T","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Locking mode for the "},{"type":"codeVoice","code":"BEGIN"},{"type":"text","text":" statement. Defaults to"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/TransactionKind\/deferred"},{"type":"text","text":". Ignored for nested (savepoint) scopes."}]}],"name":"kind"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Transaction body, isolated to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/DatabaseActor"},{"type":"text","text":". Returning normally"},{"type":"text","text":" "},{"type":"text","text":"commits (or releases the savepoint); throwing rolls back the scope’s work."}]}],"name":"block"}]},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Commits if the block returns normally; rolls back and rethrows if it throws. The block","type":"text"},{"text":" ","type":"text"},{"text":"receives the database it runs on and may suspend freely — atomicity is preserved across","type":"text"},{"text":" ","type":"text"},{"code":"await","type":"codeVoice"},{"text":"s.","type":"text"}],"type":"paragraph"},{"code":["enum TransferError: Error { case insufficientFunds }","","let fromID = 1","let toID = 2","let amount = 100","try await db.transaction { db in","  let balances = try await db.query(\"SELECT balance FROM accounts WHERE id = \\(fromID)\") { stmt, _ in","    try Int.column(of: stmt, at: 0)","  }","  guard let fromBalance = balances.first, fromBalance >= amount else {","    throw TransferError.insufficientFunds","  }","  try await db.exec(\"UPDATE accounts SET balance = balance - \\(amount) WHERE id = \\(fromID)\")","  try await db.exec(\"UPDATE accounts SET balance = balance + \\(amount) WHERE id = \\(toID)\")","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Concurrency-semantics","text":"Concurrency semantics","type":"heading"},{"inlineContent":[{"type":"text","text":"While the transaction is in flight — including while its body is suspended at an"},{"type":"text","text":" "},{"type":"codeVoice","code":"await"},{"type":"text","text":" — database operations from tasks outside the transaction suspend and resume"},{"type":"text","text":" "},{"type":"text","text":"once it commits or rolls back. Membership is tracked by a task-local token bound"},{"type":"text","text":" "},{"type":"text","text":"around "},{"type":"codeVoice","code":"block"},{"type":"text","text":": structured children ("},{"type":"codeVoice","code":"async let"},{"type":"text","text":", task groups) and unstructured"},{"type":"text","text":" "},{"type":"codeVoice","code":"Task {}"},{"type":"text","text":" inherit it and operate inside the transaction; "},{"type":"codeVoice","code":"Task.detached"},{"type":"text","text":" does not"},{"type":"text","text":" "},{"type":"text","text":"and waits like any outside caller — awaiting a detached task from the body therefore"},{"type":"text","text":" "},{"type":"text","text":"deadlocks. A waiting operation whose task is cancelled throws "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An unstructured "},{"type":"codeVoice","code":"Task {}"},{"type":"text","text":" spawned in the body must complete before the body returns"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"await"},{"type":"text","text":" its value). A task that outlives the body races the commit: its statements"},{"type":"text","text":" "},{"type":"text","text":"may run after the transaction ends, outside it. A nested "},{"type":"codeVoice","code":"transaction"},{"type":"text","text":" call from such"},{"type":"text","text":" "},{"type":"text","text":"a task fails with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/LoomCoreErrorCode\/transactionScopeLost"},{"type":"text","text":" once the enclosing scope"},{"type":"text","text":" "},{"type":"text","text":"closes underneath it — the refused scope close never touches the connection, so it"},{"type":"text","text":" "},{"type":"text","text":"cannot disturb a transaction opened later."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Transactions on "},{"inlineContent":[{"text":"different","type":"text"}],"type":"emphasis"},{"type":"text","text":" databases nest freely, but two tasks acquiring the same"},{"type":"text","text":" "},{"type":"text","text":"databases in opposite orders deadlock, exactly like locks. Acquire multiple"},{"type":"text","text":" "},{"type":"text","text":"databases’ transactions in one consistent order."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Registered services receive "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/Service\/transactionWillBegin()"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/Service\/transactionDidCommit()"},{"type":"text","text":", and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/Service\/transactionDidRollback()"},{"type":"text","text":" "},{"type":"text","text":"callbacks at the matching lifecycle points of the outermost transaction. The set of"},{"type":"text","text":" "},{"type":"text","text":"participating services is fixed when the transaction begins — a service registered"},{"type":"text","text":" "},{"type":"text","text":"while it is in flight receives no callbacks until the next transaction, and a service"},{"type":"text","text":" "},{"type":"text","text":"shut down while it is in flight receives no terminal callback."}],"type":"paragraph"},{"level":2,"anchor":"Nested-calls","text":"Nested calls","type":"heading"},{"inlineContent":[{"text":"Calling ","type":"text"},{"code":"transaction","type":"codeVoice"},{"text":" from inside an active transaction opens a ","type":"text"},{"code":"SAVEPOINT","type":"codeVoice"},{"text":" scope:","type":"text"},{"text":" ","type":"text"},{"text":"the nested block’s work is released into the enclosing transaction when it returns","type":"text"},{"text":" ","type":"text"},{"text":"normally, and rolled back to the savepoint — leaving the enclosing transaction’s","type":"text"},{"text":" ","type":"text"},{"text":"work intact — when it throws. Nested scopes fire no service callbacks (those describe","type":"text"},{"text":" ","type":"text"},{"text":"the physical transaction), and ","type":"text"},{"code":"kind","type":"codeVoice"},{"text":" is ignored because savepoints have no locking","type":"text"},{"text":" ","type":"text"},{"text":"mode. Everything, savepoints included, becomes durable only when the outermost","type":"text"},{"text":" ","type":"text"},{"text":"transaction commits.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Rethrows any error from ","type":"text"},{"type":"codeVoice","code":"block"},{"text":"; throws ","type":"text"},{"type":"codeVoice","code":"LoomError"},{"text":" if the","type":"text"},{"text":" ","type":"text"},{"code":"BEGIN","type":"codeVoice"},{"text":", ","type":"text"},{"code":"COMMIT","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SAVEPOINT","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"RELEASE","type":"codeVoice"},{"text":" itself fails, or with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/LoomCoreErrorCode\/transactionScopeLost","isActive":true,"type":"reference"},{"text":" in place of the ","type":"text"},{"code":"COMMIT","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"RELEASE","type":"codeVoice"},{"text":" when","type":"text"},{"text":" ","type":"text"},{"text":"the scope lost the connection first (the database was closed mid-flight, or an","type":"text"},{"text":" ","type":"text"},{"text":"enclosing scope exited underneath an un-awaited task) or when SQLite rolled the","type":"text"},{"text":" ","type":"text"},{"text":"physical transaction back underneath the body — an interrupted write","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/interrupt()","type":"reference","isActive":true},{"text":" or task cancellation) or an ","type":"text"},{"type":"codeVoice","code":"ON CONFLICT ROLLBACK"},{"text":" constraint.","type":"text"},{"text":" ","type":"text"},{"text":"The auto-rollback case skips the machinery’s own ","type":"text"},{"code":"ROLLBACK","type":"codeVoice"},{"text":", still fires","type":"text"},{"type":"text","text":" "},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/Service\/transactionDidRollback()","type":"reference","isActive":true},{"text":", and leaves the connection open. A genuinely","type":"text"},{"text":" ","type":"text"},{"text":"failed rollback of the outermost transaction closes the underlying handle before","type":"text"},{"text":" ","type":"text"},{"text":"rethrowing; a failed savepoint rollback leaves the handle open so the outermost","type":"text"},{"text":" ","type":"text"},{"text":"transaction can still roll everything back.","type":"text"}]}],"name":"Throws","type":"aside"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/loomcore\/database\/transaction(kind:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/LoomCore\/documentation\/LoomCore\/TransactionKind","doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/Service","doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/getService(_:)","doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/setBusyTimeout(milliseconds:)","doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/interrupt()"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/LoomCore\/documentation\/LoomCore","doc:\/\/LoomCore\/documentation\/LoomCore\/Database"]]},"sections":[],"abstract":[{"text":"Runs a block of operations atomically inside a transaction.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://LoomCore/documentation/LoomCore/Database/setBusyTimeout(milliseconds:)":{"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setBusyTimeout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"milliseconds"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s5Int32V","kind":"typeIdentifier","text":"Int32"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier"