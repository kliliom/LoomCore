{"metadata":{"externalID":"s:8LoomCore8DatabaseC11transaction4kind_xAA15TransactionKindO_xACYaYbKAA0C5ActorCYcXEtYaKlF","roleHeading":"Instance Method","modules":[{"name":"LoomCore"}],"extendedModule":"LoomCore","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transaction","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TransactionKind","kind":"typeIdentifier","preciseIdentifier":"s:8LoomCore15TransactionKindO"},{"text":", (","kind":"text"},{"text":"Database","kind":"typeIdentifier","preciseIdentifier":"s:8LoomCore8DatabaseC"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"T","kind":"typeIdentifier"}],"title":"transaction(kind:_:)","role":"symbol","symbolKind":"method"},"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/loomcore\/database\/transaction(kind:_:)"]}],"sections":[],"abstract":[{"type":"text","text":"Runs a block of operations atomically inside a transaction."}],"kind":"symbol","seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/LoomCore\/documentation\/LoomCore\/TransactionKind","doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/Service","doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/getService(_:)","doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/setBusyTimeout(milliseconds:)","doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/interrupt()"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/DatabaseActor","preciseIdentifier":"s:8LoomCore13DatabaseActorC","kind":"attribute","text":"DatabaseActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"transaction"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/TransactionKind","preciseIdentifier":"s:8LoomCore15TransactionKindO","kind":"typeIdentifier","text":"TransactionKind"},{"kind":"text","text":" = .deferred, "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"block"},{"kind":"text","text":": @"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/DatabaseActor","preciseIdentifier":"s:8LoomCore13DatabaseActorC","kind":"typeIdentifier","text":"DatabaseActor"},{"kind":"text","text":" "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" ("},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database","preciseIdentifier":"s:8LoomCore8DatabaseC","kind":"typeIdentifier","text":"Database"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"T"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"kind","content":[{"inlineContent":[{"text":"Locking mode for the ","type":"text"},{"code":"BEGIN","type":"codeVoice"},{"text":" statement. Defaults to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/TransactionKind\/deferred","isActive":true,"type":"reference"},{"text":". Ignored for nested (savepoint) scopes.","type":"text"}],"type":"paragraph"}]},{"name":"block","content":[{"inlineContent":[{"text":"Transaction body, isolated to ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/DatabaseActor","isActive":true,"type":"reference"},{"text":". Returning normally","type":"text"},{"text":" ","type":"text"},{"text":"commits (or releases the savepoint); throwing rolls back the scope’s work.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"Commits if the block returns normally; rolls back and rethrows if it throws. The block"},{"type":"text","text":" "},{"type":"text","text":"receives the database it runs on and may suspend freely — atomicity is preserved across"},{"type":"text","text":" "},{"type":"codeVoice","code":"await"},{"type":"text","text":"s."}],"type":"paragraph"},{"code":["enum TransferError: Error { case insufficientFunds }","","let fromID = 1","let toID = 2","let amount = 100","try await db.transaction { db in","  let balances = try await db.query(\"SELECT balance FROM accounts WHERE id = \\(fromID)\") { stmt, _ in","    try Int.column(of: stmt, at: 0)","  }","  guard let fromBalance = balances.first, fromBalance >= amount else {","    throw TransferError.insufficientFunds","  }","  try await db.exec(\"UPDATE accounts SET balance = balance - \\(amount) WHERE id = \\(fromID)\")","  try await db.exec(\"UPDATE accounts SET balance = balance + \\(amount) WHERE id = \\(toID)\")","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Concurrency-semantics","type":"heading","text":"Concurrency semantics","level":2},{"inlineContent":[{"text":"While the transaction is in flight — including while its body is suspended at an","type":"text"},{"text":" ","type":"text"},{"code":"await","type":"codeVoice"},{"text":" — database operations from tasks outside the transaction suspend and resume","type":"text"},{"text":" ","type":"text"},{"text":"once it commits or rolls back. Membership is tracked by a task-local token bound","type":"text"},{"text":" ","type":"text"},{"text":"around ","type":"text"},{"code":"block","type":"codeVoice"},{"text":": structured children (","type":"text"},{"code":"async let","type":"codeVoice"},{"text":", task groups) and unstructured","type":"text"},{"text":" ","type":"text"},{"code":"Task {}","type":"codeVoice"},{"text":" inherit it and operate inside the transaction; ","type":"text"},{"code":"Task.detached","type":"codeVoice"},{"text":" does not","type":"text"},{"text":" ","type":"text"},{"text":"and waits like any outside caller — awaiting a detached task from the body therefore","type":"text"},{"text":" ","type":"text"},{"text":"deadlocks. A waiting operation whose task is cancelled throws ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An unstructured ","type":"text"},{"code":"Task {}","type":"codeVoice"},{"text":" spawned in the body must complete before the body returns","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"await","type":"codeVoice"},{"text":" its value). A task that outlives the body races the commit: its statements","type":"text"},{"text":" ","type":"text"},{"text":"may run after the transaction ends, outside it. A nested ","type":"text"},{"code":"transaction","type":"codeVoice"},{"text":" call from such","type":"text"},{"text":" ","type":"text"},{"text":"a task fails with ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/LoomCoreErrorCode\/transactionScopeLost","isActive":true,"type":"reference"},{"text":" once the enclosing scope","type":"text"},{"text":" ","type":"text"},{"text":"closes underneath it — the refused scope close never touches the connection, so it","type":"text"},{"text":" ","type":"text"},{"text":"cannot disturb a transaction opened later.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Transactions on ","type":"text"},{"inlineContent":[{"type":"text","text":"different"}],"type":"emphasis"},{"text":" databases nest freely, but two tasks acquiring the same","type":"text"},{"text":" ","type":"text"},{"text":"databases in opposite orders deadlock, exactly like locks. Acquire multiple","type":"text"},{"text":" ","type":"text"},{"text":"databases’ transactions in one consistent order.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Registered services receive ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/Service\/transactionWillBegin()","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/Service\/transactionDidCommit()","isActive":true,"type":"reference"},{"text":", and ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/Service\/transactionDidRollback()","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"callbacks at the matching lifecycle points of the outermost transaction. The set of","type":"text"},{"text":" ","type":"text"},{"text":"participating services is fixed when the transaction begins — a service registered","type":"text"},{"text":" ","type":"text"},{"text":"while it is in flight receives no callbacks until the next transaction, and a service","type":"text"},{"text":" ","type":"text"},{"text":"shut down while it is in flight receives no terminal callback.","type":"text"}],"type":"paragraph"},{"anchor":"Nested-calls","type":"heading","text":"Nested calls","level":2},{"inlineContent":[{"type":"text","text":"Calling "},{"type":"codeVoice","code":"transaction"},{"type":"text","text":" from inside an active transaction opens a "},{"type":"codeVoice","code":"SAVEPOINT"},{"type":"text","text":" scope:"},{"type":"text","text":" "},{"type":"text","text":"the nested block’s work is released into the enclosing transaction when it returns"},{"type":"text","text":" "},{"type":"text","text":"normally, and rolled back to the savepoint — leaving the enclosing transaction’s"},{"type":"text","text":" "},{"type":"text","text":"work intact — when it throws. Nested scopes fire no service callbacks (those describe"},{"type":"text","text":" "},{"type":"text","text":"the physical transaction), and "},{"type":"codeVoice","code":"kind"},{"type":"text","text":" is ignored because savepoints have no locking"},{"type":"text","text":" "},{"type":"text","text":"mode. Everything, savepoints included, becomes durable only when the outermost"},{"type":"text","text":" "},{"type":"text","text":"transaction commits."}],"type":"paragraph"},{"name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Rethrows any error from "},{"code":"block","type":"codeVoice"},{"type":"text","text":"; throws "},{"code":"LoomError","type":"codeVoice"},{"type":"text","text":" if the"},{"type":"text","text":" "},{"code":"BEGIN","type":"codeVoice"},{"type":"text","text":", "},{"code":"COMMIT","type":"codeVoice"},{"type":"text","text":", "},{"code":"SAVEPOINT","type":"codeVoice"},{"type":"text","text":", or "},{"code":"RELEASE","type":"codeVoice"},{"type":"text","text":" itself fails, or with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/LoomCoreErrorCode\/transactionScopeLost","isActive":true},{"type":"text","text":" in place of the "},{"code":"COMMIT","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"RELEASE","type":"codeVoice"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"the scope lost the connection first (the database was closed mid-flight, or an"},{"type":"text","text":" "},{"type":"text","text":"enclosing scope exited underneath an un-awaited task) or when SQLite rolled the"},{"type":"text","text":" "},{"type":"text","text":"physical transaction back underneath the body — an interrupted write"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/interrupt()","isActive":true},{"type":"text","text":" or task cancellation) or an "},{"code":"ON CONFLICT ROLLBACK","type":"codeVoice"},{"type":"text","text":" constraint."},{"type":"text","text":" "},{"type":"text","text":"The auto-rollback case skips the machinery’s own "},{"code":"ROLLBACK","type":"codeVoice"},{"type":"text","text":", still fires"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/Service\/transactionDidRollback()","isActive":true},{"type":"text","text":", and leaves the connection open. A genuinely"},{"type":"text","text":" "},{"type":"text","text":"failed rollback of the outermost transaction closes the underlying handle before"},{"type":"text","text":" "},{"type":"text","text":"rethrowing; a failed savepoint rollback leaves the handle open so the outermost"},{"type":"text","text":" "},{"type":"text","text":"transaction can still roll everything back."}]}],"type":"aside","style":"note"}]}],"hierarchy":{"paths":[["doc:\/\/LoomCore\/documentation\/LoomCore","doc:\/\/LoomCore\/documentation\/LoomCore\/Database"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/transaction(kind:_:)"},"references":{"doc://LoomCore/documentation/LoomCore/TransactionKind/deferred":{"url":"\/documentation\/loomcore\/transactionkind\/deferred","abstract":[{"type":"text","text":"Defers lock acquisition until the first read or write inside the transaction."}],"kind":"symbol","type":"topic","title":"TransactionKind.deferred","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"deferred"}],"role":"symbol","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/TransactionKind\/deferred"},"doc://LoomCore/documentation/LoomCore/D