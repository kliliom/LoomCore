{"metadata":{"role":"collectionGroup","roleHeading":"API Collection","title":"Safe SQL Interpolation","modules":[{"name":"LoomCore"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/loomcore\/safeinterpolation"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LoomCore\/documentation\/LoomCore\/SafeInterpolation"},"seeAlsoSections":[{"anchor":"Articles","identifiers":["doc:\/\/LoomCore\/documentation\/LoomCore\/IndexConventions","doc:\/\/LoomCore\/documentation\/LoomCore\/ConcurrencyModel","doc:\/\/LoomCore\/documentation\/LoomCore\/StoringCustomTypes","doc:\/\/LoomCore\/documentation\/LoomCore\/QueryingJSON","doc:\/\/LoomCore\/documentation\/LoomCore\/FullTextSearch","doc:\/\/LoomCore\/documentation\/LoomCore\/TransactionsAndServices"],"generated":true,"title":"Articles"}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"LoomCore uses Swift’s string interpolation as its primary SQL-construction API. Every interpolated value defaults to "},{"inlineContent":[{"type":"codeVoice","code":".bind"},{"type":"text","text":" mode"}],"type":"strong"},{"type":"text","text":" — it is added to the statement as a parameter ("},{"type":"codeVoice","code":"?"},{"type":"text","text":") and its value is bound at execution time. This is the safe path; you cannot accidentally concatenate user input into the SQL text."}],"type":"paragraph"},{"code":["let user = \"Alice'; DROP TABLE users; --\"","try await db.exec(\"INSERT INTO users (name) VALUES (\\(user))\")","\/\/ SQL: \"INSERT INTO users (name) VALUES (?)\"","\/\/ Bound: \"Alice'; DROP TABLE users; --\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The malicious payload becomes a literal string value in the database. There is no way to break out of the parameter binding."}],"type":"paragraph"},{"anchor":"Raw-mode","type":"heading","text":"Raw mode","level":3},{"inlineContent":[{"type":"text","text":"Some things cannot be parameters — table names, column names, SQL keywords. For these, opt in to "},{"type":"codeVoice","code":".raw"},{"type":"text","text":" mode:"}],"type":"paragraph"},{"code":["let table = \"users\"  \/\/ from your own configuration, NOT user input","try await db.exec(\"SELECT * FROM \\(table, mode: .raw) WHERE active = \\(true)\")","\/\/ SQL: \"SELECT * FROM users WHERE active = ?\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":".raw"},{"type":"text","text":" skips parameter binding and pastes the value directly into the SQL string. This is exactly the surface SQL injection lives on."}],"type":"paragraph"},{"name":"Warning","content":[{"inlineContent":[{"type":"text","text":"Never pass untrusted input through "},{"type":"codeVoice","code":".raw"},{"type":"text","text":". If user input determines a table or column name, validate it against an allowlist of known names before using "},{"type":"codeVoice","code":".raw"},{"type":"text","text":", or use "},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/ColumnExpression","type":"reference","isActive":true},{"type":"text","text":" which always quotes identifiers safely."}],"type":"paragraph"}],"type":"aside","style":"warning"},{"anchor":"ColumnExpression-the-safe-identifier-path","type":"heading","text":"ColumnExpression — the safe identifier path","level":3},{"inlineContent":[{"type":"text","text":"When you need to refer to a column by name, "},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/ColumnExpression","type":"reference","isActive":true},{"type":"text","text":" is preferable to "},{"type":"codeVoice","code":".raw"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let nameColumn = ColumnExpression<String>(\"name\")","let userEmail  = ColumnExpression<String>(\"email\", of: \"users\")","","try await db.query(\"SELECT \\(nameColumn) FROM users\") { stmt, _ in","  try String.column(of: stmt, at: 0)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"ColumnExpression"},{"type":"text","text":" always renders quoted identifiers ("},{"type":"codeVoice","code":"\"name\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"users\".\"email\""},{"type":"text","text":"), escapes embedded double quotes by doubling, and rejects empty or NUL-containing names at construction. This makes reserved words like "},{"type":"codeVoice","code":"order"},{"type":"text","text":" and identifiers with spaces safe to use without special handling."}],"type":"paragraph"},{"anchor":"JSON-paths-literal-by-design","type":"heading","text":"JSON paths — literal by design","level":3},{"inlineContent":[{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/JSONPath","type":"reference","isActive":true},{"type":"text","text":" values (the "},{"type":"codeVoice","code":"\"$.name\""},{"type":"text","text":" arguments of the JSON expressions) render as single-quoted, quote-doubled literals rather than bound parameters — the same treatment as "},{"type":"codeVoice","code":"LIKE"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"ESCAPE"},{"type":"text","text":" operand. SQLite matches an expression index on "},{"type":"codeVoice","code":"json_extract(\"col\", '$.a')"},{"type":"text","text":" only when the path is a literal token, so binding it would silently disable indexed JSON lookups. The doubling makes breaking out of the literal impossible, but a path still selects which node is read — treat it like a column name, not user input."}],"type":"paragraph"},{"anchor":"Composing-statements","type":"heading","text":"Composing statements","level":3},{"inlineContent":[{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/SQLStatement","type":"reference","isActive":true},{"type":"text","text":" values can be combined while preserving parameter ordering:"}],"type":"paragraph"},{"code":["let minAge = 18","","var stmt: SQLStatement = \"SELECT * FROM users\"","stmt += \"WHERE age > \\(minAge)\"","stmt += \"ORDER BY name\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each fragment carries its own binders; concatenation appends them in order. There is no parameter-renumbering to worry about."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"When "},{"code":"\\(value)","type":"codeVoice"},{"type":"text","text":" becomes a parameter, when it becomes literal text, and how to keep injection-prone surfaces small."}],"hierarchy":{"paths":[["doc:\/\/LoomCore\/documentation\/LoomCore"]]},"kind":"article","topicSections":[{"anchor":"Topics","identifiers":["doc:\/\/LoomCore\/documentation\/LoomCore\/SQLStatement","doc:\/\/LoomCore\/documentation\/LoomCore\/SQLBuilder","doc:\/\/LoomCore\/documentation\/LoomCore\/SQLBuilder\/AppendMode","doc:\/\/LoomCore\/documentation\/LoomCore\/ColumnExpression"]}],"references":{"doc://LoomCore/documentation/LoomCore":{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore","abstract":[{"text":"A type-safe SQLite wrapper for Swift 6+ built on actor isolation.","type":"text"}],"kind":"symbol","type":"topic","title":"LoomCore","role":"collection","url":"\/documentation\/loomcore"},"doc://LoomCore/documentation/LoomCore/SQLBuilder":{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/SQLBuilder","navigatorTitle":[{"kind":"identifier","text":"SQLBuilder"}],"abstract":[{"text":"String interpolation handler that builds ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/SQLStatement"},{"text":" values with safe parameter binding.","type":"text"}],"kind":"symbol","type":"topic","title":"SQLBuilder","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SQLBuilder"}],"role":"symbol","url":"\/documentation\/loomcore\/sqlbuilder"},"doc://LoomCore/documentation/LoomCore/SQLStatement":{"url":"\/documentation\/loomcore\/sqlstatement","role":"symbol","title":"SQLStatement","type":"topic","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/SQLStatement","abstract":[{"text":"SQL statement with safe parameter binding.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SQLStatement","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"SQLStatement","kind":"identifier"}]},"doc://LoomCore/documentation/LoomCore/IndexConventions":{"url":"\/documentation\/loomcore\/indexconventions","role":"collectionGroup","title":"Index Conventions","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/IndexConventions","type":"topic","abstract":[{"text":"How LoomCore handles SQLite’s asymmetric 1-based parameter \/ 0-based column indexing.","type":"text"}],"kind":"article"},"doc://LoomCore/documentation/LoomCore/JSONPath":{"url":"\/documentation\/loomcore\/jsonpath","role":"symbol","title":"JSONPath","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/JSONPath","type":"topic","abstract":[{"text":"A SQLite JSON path such as ","type":"text"},{"code":"$.user.name","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$[0]","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"$.\"key with spaces\"","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"JSONPath","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"JSONPath","kind":"identifier"}]},"doc://LoomCore/documentation/LoomCore/ColumnExpression":{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/ColumnExpression","navigatorTitle":[{"text":"ColumnExpression","kind":"identifier"}],"abstract":[{"text":"Typed reference to a SQL column, optionally qualified by a table name.","type":"text"}],"kind":"symbol","type":"topic","title":"ColumnExpression","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ColumnExpression","kind":"identifier"}],"role":"symbol","url":"\/documentation\/loomcore\/columnexpression"},"doc://LoomCore/documentation/LoomCore/TransactionsAndServices":{"url":"\/documentation\/loomcore\/transactionsandservices","role":"collectionGroup","title":"Transactions and Services","type":"topic","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/TransactionsAndServices","abstract":[{"text":"Atomic operations, savepoint nesting, transaction gating, and lifecycle hooks for cache invalidation.","type":"text"}],"kind":"article"},"doc://LoomCore/documentation/LoomCore/StoringCustomTypes":{"url":"\/documentation\/loomcore\/storingcustomtypes","role":"collectionGroup","title":"Storing Custom Types","type":"topic","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/StoringCustomTypes","abstract":[{"text":"How ","type":"text"},{"type":"codeVoice","code":"Bindable"},{"text":" maps Swift types to SQLite storage, and how to extend it.","type":"text"}],"kind":"article"},"doc://LoomCore/documentation/LoomCore/SQLBuilder/AppendMode":{"url":"\/documentation\/loomcore\/sqlbuilder\/appendmode","role":"symbol","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/SQLBuilder\/AppendMode","type":"topic","title":"SQLBuilder.AppendMode","abstract":[{"text":"Controls how an interpolated value is rendered into the SQL.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AppendMode"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AppendMode"}]},"doc://LoomCore/documentation/LoomCore/QueryingJSON":{"url":"\/documentation\/loomcore\/queryingjson","role":"collectionGroup","title":"Querying JSON","type":"topic","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/QueryingJSON","abstract":[{"text":"Extract, filter, modify, build, and iterate JSON documents with typed expressions over SQLite’s JSON functions.","type":"text"}],"kind":"article"},"doc://LoomCore/documentation/LoomCore/FullTextSearch":{"url":"\/documentation\/loomcore\/fulltextsearch","role":"collectionGroup","title":"Full-Text Search","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FullTextSearch","type":"topic","abstract":[{"text":"Match, rank, and excerpt text with typed expressions over SQLite’s FTS5 extension.","type":"text"}],"kind":"article"},"doc://LoomCore/documentation/LoomCore/ConcurrencyModel":{"url":"\/documentation\/loomcore\/concurrencymodel","role":"collectionGroup","title":"Concurrency and Actor Isolation","type":"topic","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/ConcurrencyModel","abstract":[{"text":"How LoomCore makes SQLite race-free without explicit locking.","type":"text"}],"kind":"article"}}}