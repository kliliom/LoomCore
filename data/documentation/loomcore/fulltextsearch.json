{"metadata":{"role":"collectionGroup","title":"Full-Text Search","roleHeading":"API Collection","modules":[{"name":"LoomCore"}]},"variants":[{"paths":["\/documentation\/loomcore\/fulltextsearch"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LoomCore\/documentation\/LoomCore\/FullTextSearch"},"seeAlsoSections":[{"title":"Articles","identifiers":["doc:\/\/LoomCore\/documentation\/LoomCore\/IndexConventions","doc:\/\/LoomCore\/documentation\/LoomCore\/SafeInterpolation","doc:\/\/LoomCore\/documentation\/LoomCore\/ConcurrencyModel","doc:\/\/LoomCore\/documentation\/LoomCore\/StoringCustomTypes","doc:\/\/LoomCore\/documentation\/LoomCore\/QueryingJSON","doc:\/\/LoomCore\/documentation\/LoomCore\/TransactionsAndServices"],"generated":true,"anchor":"Articles"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"SQLite ships FTS5 — virtual tables with a full-text index, the ","type":"text"},{"code":"MATCH","type":"codeVoice"},{"text":" operator, ","type":"text"},{"code":"bm25","type":"codeVoice"},{"text":" relevance scoring, and the ","type":"text"},{"code":"snippet","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"highlight","type":"codeVoice"},{"text":" auxiliary functions — and every OS version LoomCore supports includes it. This article shows the typed expression DSL over those features.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Creating the index itself stays plain SQL, in line with LoomCore not being an ORM:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["try await db.exec(raw: \"CREATE VIRTUAL TABLE articles USING fts5(title, body)\")"],"type":"codeListing"},{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Table","type":"reference","isActive":true},{"text":" then names that table for the DSL. Pass ","type":"text"},{"code":"columns","type":"codeVoice"},{"text":" (in declaration order) when you plan to use ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Table\/snippet(column:prefix:suffix:ellipsis:maxTokens:)","type":"reference","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Table\/highlight(column:prefix:suffix:)","type":"reference","isActive":true},{"text":", which address columns by name; matching and ranking work without it.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let articles = FTS5Table(\"articles\", columns: [\"title\", \"body\"])"],"type":"codeListing"},{"text":"Matching","anchor":"Matching","level":3,"type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Table\/match(_:)-2fk37","type":"reference","isActive":true},{"text":" builds the ","type":"text"},{"code":"MATCH","type":"codeVoice"},{"text":" predicate. The query string uses FTS5’s own syntax — bare tokens are AND-ed, ","type":"text"},{"code":"\"quoted text\"","type":"codeVoice"},{"text":" is a phrase, ","type":"text"},{"code":"title : swift","type":"codeVoice"},{"text":" filters a column — and is bound as a parameter, so it can never escape the ","type":"text"},{"code":"MATCH","type":"codeVoice"},{"text":" operand into SQL:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let articles = FTS5Table(\"articles\")","let userInput = \"swift database\"","","let hits = try await db.query(","  \"SELECT title FROM articles WHERE \\(articles.match(userInput))\"",") { stmt, _ in","  try String.column(of: stmt, at: 0)","}"],"type":"codeListing"},{"inlineContent":[{"text":"Binding is the opposite choice from ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/JSONPath","type":"reference","isActive":true},{"text":", which inlines its paths so SQLite can match expression indexes; no such optimization applies to ","type":"text"},{"code":"MATCH","type":"codeVoice"},{"text":", and binding means statements differing only in search text share one prepared-statement cache entry. The cost of accepting raw syntax is that a malformed query — an unclosed quote, a dangling ","type":"text"},{"code":"AND","type":"codeVoice"},{"text":" — only fails when SQLite executes the statement, surfacing as a thrown ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/LoomError","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"style":"important","name":"Important","content":[{"inlineContent":[{"text":"Binding prevents SQL injection; it does not sandbox the FTS5 query language itself. A whole-table match hands the searcher FTS5’s full grammar, including column filters over ","type":"text"},{"type":"strong","inlineContent":[{"text":"every","type":"text"}]},{"text":" indexed column — ","type":"text"},{"type":"codeVoice","code":"secret : guess"},{"text":" probes a column your UI never displays, and ","type":"text"},{"type":"codeVoice","code":"*"},{"text":" prefixes narrow guesses further. Pass raw user input through only when every indexed column is meant to be user-searchable. Otherwise route user text through ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Query\/phrase(_:fromStart:)"},{"text":" or ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Query\/prefix(_:fromStart:)"},{"text":" (metacharacters are inert there), scope the search with an explicit ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Query\/column(_:_:)"},{"text":" filter or a single-column ","type":"text"},{"type":"codeVoice","code":"match(_:)"},{"text":" (an inner filter cannot widen a column-scoped match), and keep text that must never be searchable out of the FTS5 index entirely.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"inlineContent":[{"text":"A single column can be matched directly through ","type":"text"},{"code":"match(_:)","type":"codeVoice"},{"text":" on a ","type":"text"},{"code":"String","type":"codeVoice"},{"text":"-typed ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/ColumnExpression","type":"reference","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let title = ColumnExpression<String>(\"title\")","let titled = try await db.query(\"SELECT title FROM articles WHERE \\(title.match(\"swift\"))\") { stmt, _ in","  try String.column(of: stmt, at: 0)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A match predicate composes with ","type":"text"},{"code":"&&","type":"codeVoice"},{"text":" only. It also type-checks under ","type":"text"},{"code":"||","type":"codeVoice"},{"text":" and prefix ","type":"text"},{"code":"!","type":"codeVoice"},{"text":", but SQLite rejects ","type":"text"},{"code":"MATCH","type":"codeVoice"},{"text":" in those positions at execution — express alternatives and exclusions inside the query itself with ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Query\/or(_:)","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Query\/not(_:)","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"The-query-builder","text":"The query builder","type":"heading"},{"inlineContent":[{"text":"For queries assembled in code, ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Query","type":"reference","isActive":true},{"text":" renders FTS5 syntax that is correct by construction. Phrase text is always quoted with embedded quotes doubled, so it is treated as data — ","type":"text"},{"code":"*","type":"codeVoice"},{"text":", ","type":"text"},{"code":"^","type":"codeVoice"},{"text":", ","type":"text"},{"code":":","type":"codeVoice"},{"text":", and operators inside it have no effect:","type":"text"}],"type":"paragraph"},{"code":["let articles = FTS5Table(\"articles\")","","\/\/ (\"swift concurrency\" AND \"actor\"*) — a phrase requires adjacent tokens,","\/\/ a prefix matches \"actor\", \"actors\", \"actor-isolated\", …","let query = FTS5Query.phrase(\"swift concurrency\").and(.prefix(\"actor\"))","","let hits = try await db.query(","  \"SELECT title FROM articles WHERE \\(articles.match(query))\"",") { stmt, _ in","  try String.column(of: stmt, at: 0)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Query\/phrase(_:fromStart:)"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Query\/prefix(_:fromStart:)"},{"text":" are the leaves (","type":"text"},{"code":"fromStart","type":"codeVoice"},{"text":" prepends ","type":"text"},{"code":"^","type":"codeVoice"},{"text":", matching only at the start of a column); ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Query\/and(_:)"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Query\/or(_:)"},{"text":", and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Query\/not(_:)"},{"text":" combine them, always parenthesizing so precedence never depends on FTS5’s grammar. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Query\/near(_:distance:)"},{"text":" requires phrases to appear close together, and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Query\/column(_:_:)"},{"text":" \/ ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Query\/columns(_:_:)"},{"text":" restrict a sub-query to specific columns:","type":"text"}],"type":"paragraph"},{"code":["\/\/ {\"title\" \"summary\"} : (NEAR(\"swift\" \"database\", 5) OR \"sqlite\")","let query = FTS5Query.columns(","  [\"title\", \"summary\"],","  .near([\"swift\", \"database\"], distance: 5).or(.phrase(\"sqlite\"))",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The rendered query is bound exactly like a raw string, so the two entry points mix freely."}],"type":"paragraph"},{"level":3,"anchor":"Ranking","text":"Ranking","type":"heading"},{"inlineContent":[{"type":"text","text":"Within a full-text query, the hidden "},{"isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Table\/rank","type":"reference"},{"text":" column carries each row’s relevance score. Scores are negative and lower is more relevant, so ascending ","type":"text"},{"code":"ORDER BY","type":"codeVoice"},{"type":"text","text":" returns the best matches first:"}],"type":"paragraph"},{"code":["let articles = FTS5Table(\"articles\")","let best = try await db.query(","  \"SELECT title FROM articles WHERE \\(articles.match(\"swift\")) ORDER BY \\(articles.rank)\"",") { stmt, _ in","  try String.column(of: stmt, at: 0)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Outside a ","type":"text"},{"code":"MATCH","type":"codeVoice"},{"text":" statement the column is NULL, hence its ","type":"text"},{"code":"Double?","type":"codeVoice"},{"text":" type. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Table\/bm25(weights:)"},{"text":" exposes the same scoring function with per-column weights — one weight per indexed column, in declaration order:","type":"text"}],"type":"paragraph"},{"code":["let articles = FTS5Table(\"articles\", columns: [\"title\", \"body\"])","","\/\/ Matches in the title count ten times as much as matches in the body.","let ranked = try await db.query(","  \"SELECT title FROM articles WHERE \\(articles.match(\"swift\")) ORDER BY \\(articles.bm25(weights: [10, 1]))\"",") { stmt, _ in","  try String.column(of: stmt, at: 0)","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Snippets-and-highlights","text":"Snippets and highlights","type":"heading","level":3},{"inlineContent":[{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Table\/snippet(column:prefix:suffix:ellipsis:maxTokens:)","isActive":true,"type":"reference"},{"text":" extracts a fragment of matched text — up to ","type":"text"},{"code":"maxTokens","type":"codeVoice"},{"text":" tokens (at most 64) around the best match, with each matched token wrapped in ","type":"text"},{"code":"prefix","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"suffix","type":"codeVoice"},{"text":" and truncation marked by ","type":"text"},{"code":"ellipsis","type":"codeVoice"},{"text":". ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Table\/highlight(column:prefix:suffix:)"},{"type":"text","text":" returns the column’s full text with the same marking:"}],"type":"paragraph"},{"code":["let articles = FTS5Table(\"articles\", columns: [\"title\", \"body\"])","","let results = try await db.query(","  \"\"\"","  SELECT","    \\(articles.highlight(column: \"title\", prefix: \"<b>\", suffix: \"<\/b>\")),","    \\(articles.snippet(column: \"body\", prefix: \"<b>\", suffix: \"<\/b>\", ellipsis: \"…\", maxTokens: 12))","  FROM articles WHERE \\(articles.match(\"swift\")) ORDER BY \\(articles.rank)","  \"\"\"",") { stmt, _ in","  (try String?.column(of: stmt, at: 0), try String?.column(of: stmt, at: 1))","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"SQLite identifies these columns by positional index; LoomCore resolves the name against the table’s declared "},{"code":"columns","type":"codeVoice"},{"type":"text","text":", so the list must include every column you excerpt. Both functions return NULL — hence "},{"code":"String?","type":"codeVoice"},{"type":"text","text":" — when the underlying column value is NULL. Omitting "},{"code":"column:","type":"codeVoice"},{"type":"text","text":" from "},{"code":"snippet","type":"codeVoice"},{"type":"text","text":" lets FTS5 pick the most relevant column itself."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"The declared "},{"code":"columns","type":"codeVoice"},{"type":"text","text":" order is load-bearing and never checked against the live table. If a migration reorders or inserts a column and the Swift declaration isn’t updated, the name resolves to a valid but "},{"type":"emphasis","inlineContent":[{"type":"text","text":"wrong"}]},{"type":"text","text":" index and every snippet and highlight silently excerpts the wrong column — no error is raised. Pin the declaration to the live schema with "},{"isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Table\/verifyColumns(on:)","type":"reference"},{"type":"text","text":" in an integration test or at startup."}],"type":"paragraph"}],"style":"warning","name":"Warning","type":"aside"}]}],"abstract":[{"text":"Match, rank, and excerpt text with typed expressions over SQLite’s FTS5 extension.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/LoomCore\/documentation\/LoomCore"]]},"kind":"article","topicSections":[{"identifiers":["doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Table","doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Query","doc:\/\/LoomCore\/documentation\/LoomCore\/MatchExpression","doc:\/\/LoomCore\/documentation\/LoomCore\/BM25","doc:\/\/LoomCore\/documentation\/LoomCore\/Snippet","doc:\/\/LoomCore\/documentation\/LoomCore\/Highlight"],"anchor":"Topics"}],"references":{"doc://LoomCore/documentation/LoomCore/SafeInterpolation":{"url":"\/documentation\/loomcore\/safeinterpolation","role":"collectionGroup","title":"Safe SQL Interpolation","type":"topic","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/SafeInterpolation","abstract":[{"text":"When ","type":"text"},{"type":"codeVoice","code":"\\(value)"},{"text":" becomes a parameter, when it becomes literal text, and how to keep injection-prone surfaces small.","type":"text"}],"kind":"article"},"doc://LoomCore/documentation/LoomCore":{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore","abstract":[{"text":"A type-safe SQLite wrapper for Swift 6+ built on actor isolation.","type":"text"}],"kind":"symbol","type":"topic","title":"LoomCore","role":"collection","url":"\/documentation\/loomcore"},"doc://LoomCore/documentation/LoomCore/FTS5Query":{"url":"\/documentation\/loomcore\/fts5query","role":"symbol","title":"FTS5Query","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Query","type":"topic","abstract":[{"text":"A typed FTS5 match query, built from phrases and combinators and rendered to FTS5","type":"text"},{"text":" ","type":"text"},{"text":"query syntax.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FTS5Query","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"FTS5Query","kind":"identifier"}]},"doc://LoomCore/documentation/LoomCore/MatchExpression":{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/MatchExpression","navigatorTitle":[{"text":"MatchExpression","kind":"identifier"}],"abstract":[{"text":"Full-text match expression rendering SQL ","type":"text"},{"code":"MATCH","type":"codeVoice"},{"text":" against an FTS5 table or column.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MatchExpression","kind":"identifier"}],"title":"MatchExpression","url":"\/documentation\/loomcore\/matchexpression","kind":"symbol"},"doc://LoomCore/documentation/LoomCore/FTS5Query/not(_:)":{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Query\/not(_:)","abstract":[{"text":"Matches rows satisfying this query but not ","type":"text"},{"code":"other","type":"codeVoice"},{"text":" (FTS5’s binary ","type":"text"},{"code":"NOT","type":"codeVoice"},{"text":").","type":"text"}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"not"},{"kind":"text","text":"("},{"preciseIdentifier":"s:8LoomCore9FTS5QueryV","kind":"typeIdentifier","text":"FTS5Query"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:8LoomCore9FTS5QueryV","kind":"typeIdentifier","text":"FTS5Query"}],"title":"not(_:)","url":"\/documentation\/loomcore\/fts5query\/not(_:)","kind":"symbol"},"doc://LoomCore/documentation/LoomCore/JSONPath":{"url":"\/documentation\/loomcore\/jsonpath","role":"symbol","title":"JSONPath","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/JSONPath","type":"topic","abstract":[{"text":"A SQLite JSON path such as ","type":"text"},{"code":"$.user.name","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$[0]","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"$.\"key with spaces\"","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"JSONPath","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"JSONPath","kind":"identifier"}]},"doc://LoomCore/documentation/LoomCore/FTS5Table/snippet(column:prefix:suffix:ellipsis:maxTokens:)":{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Table\/snippet(column:prefix:suffix:ellipsis:maxTokens:)","abstract":[{"text":"Extracts a highlighted fragment of a named column via FTS5’s ","type":"text"},{"code":"SNIPPET()","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","type":"topic","title":"snippet(column:prefix:suffix:ellipsis:maxTokens:)","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"snippet"},{"kind":"text","text":"("},{"text":"column","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"prefix","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"suffix","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"ellipsis","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"maxTokens","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Snippet","kind":"typeIdentifier","preciseIdentifier":"s:8LoomCore7SnippetV"}],"role":"symbol","url":"\/documentation\/loomcore\/fts5table\/snippet(column:prefix:suffix:ellipsis:maxtokens:)"},"doc://LoomCore/documentation/LoomCore/FTS5Query/phrase(_:fromStart:)":{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Query\/phrase(_:fromStart:)","abstract":[{"text":"A quoted phrase: the tokens of ","type":"text"},{"code":"text","type":"codeVoice"},{"text":" must appear adjacently, in order.","type":"text"}],"kind":"symbol","type":"topic","title":"phrase(_:fromStart:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"phrase"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"fromStart"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:8LoomCore9FTS5QueryV","text":"FTS5Query","kind":"typeIdentifier"}],"role":"symbol","url":"\/documentation\/loomcore\/fts5query\/phrase(_:fromstart:)"},"doc://LoomCore/documentation/LoomCore/FTS5Query/column(_:_:)":{"url":"\/documentation\/loomcore\/fts5query\/column(_:_:)","role":"symbol","title":"column(_:_:)","type":"topic","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Query\/column(_:_:)","abstract":[{"text":"Restricts ","type":"text"},{"code":"query","type":"codeVoice"},{"text":" to a single column.","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"column","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:8LoomCore9FTS5QueryV","text":"FTS5Query","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:8LoomCore9FTS5QueryV","text":"FTS5Query","kind":"typeIdentifier"}],"kind":"symbol"},"doc://LoomCore/documentation/LoomCore/FTS5Table/match(_:)-2fk37":{"url":"\/documentation\/loomcore\/fts5table\/match(_:)-2fk37","role":"symbol","title":"match(_:)","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FTS5Table\/match(_:)-2fk37","type":"topic","abstract":[{"text":"Tests whether a row matches an FTS5 query, searching all indexed columns.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"match","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"MatchExpression","kind":"typeIdentifier","preciseIdentifier":"s:8LoomCore15MatchExpressionV"},{"text":"<","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol"},"doc://LoomCore/documentation/LoomCore/FTS