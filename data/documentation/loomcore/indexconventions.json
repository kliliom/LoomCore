{"metadata":{"modules":[{"name":"LoomCore"}],"title":"Index Conventions","role":"collectionGroup","roleHeading":"API Collection"},"identifier":{"url":"doc:\/\/LoomCore\/documentation\/LoomCore\/IndexConventions","interfaceLanguage":"swift"},"kind":"article","topicSections":[{"anchor":"Topics","identifiers":["doc:\/\/LoomCore\/documentation\/LoomCore\/ManagedIndex","doc:\/\/LoomCore\/documentation\/LoomCore\/Bindable\/bind(to:value:at:)-8hkdq","doc:\/\/LoomCore\/documentation\/LoomCore\/Bindable\/column(of:at:)-4waew"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"SQLite uses two different indexing conventions, and getting them wrong is a common source of subtle bugs:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Parameter binding is 1-based.","type":"text"}]},{"type":"text","text":" The leftmost "},{"type":"codeVoice","code":"?"},{"type":"text","text":" in a prepared statement is index "},{"code":"1","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Column extraction is 0-based.","type":"text"}]},{"text":" The leftmost column in a result row is index ","type":"text"},{"type":"codeVoice","code":"0"},{"type":"text","text":"."}]}]}]},{"inlineContent":[{"text":"LoomCore preserves these conventions exactly rather than normalizing them, because flattening would hide which side of the API you are on and make off-by-one errors easier — not harder.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Parameter indices are 1-based:","try await db.exec(","  raw: \"INSERT INTO users (name, age) VALUES (?, ?)\",","  binder: { stmt in","    try \"Alice\".bind(to: stmt, at: 1)  \/\/ leftmost ?","    try 30.bind(to: stmt, at: 2)       \/\/ second ?","  }",")","","\/\/ Column indices are 0-based:","let rows = try await db.query(raw: \"SELECT name, age FROM users\") { stmt, _ in","  let name = try String.column(of: stmt, at: 0)  \/\/ leftmost column","  let age  = try Int.column(of: stmt, at: 1)     \/\/ second column","  return (name, age)","}"],"type":"codeListing"},{"level":3,"text":"Avoiding off-by-one errors","anchor":"Avoiding-off-by-one-errors","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For multi-column statements, the safest pattern is "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/ManagedIndex"},{"text":". It auto-increments around binds and column reads — for parameters it increments ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" binding, so the first bind hits index 1; for columns it increments "},{"type":"emphasis","inlineContent":[{"text":"after","type":"text"}]},{"type":"text","text":" reading, so the first read hits index 0."}]},{"code":["struct User {","  let id: Int","  let name: String","  let email: String","  let age: Int","}","","let users = try await db.query(","  raw: \"SELECT id, name, email, age FROM users WHERE status = ?\",","  binder: { stmt, index in","    try \"active\".bind(to: stmt, at: &index)        \/\/ → param 1","  },","  stepper: { stmt, index, stop in","    let id    = try Int.column(of: stmt, at: &index)     \/\/ → column 0","    let name  = try String.column(of: stmt, at: &index)  \/\/ → column 1","    let email = try String.column(of: stmt, at: &index)  \/\/ → column 2","    let age   = try Int.column(of: stmt, at: &index)     \/\/ → column 3","    return User(id: id, name: name, email: email, age: age)","  }",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"When you add or remove a column, the indices shift automatically. There are no magic numbers to renumber."}],"type":"paragraph"},{"text":"When to use raw indices","level":3,"anchor":"When-to-use-raw-indices","type":"heading"},{"inlineContent":[{"type":"text","text":"Raw indices ("},{"code":"Int32","type":"codeVoice"},{"type":"text","text":") are still useful for:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Reading a single column — ","type":"text"},{"code":"try String.column(of: stmt, at: 0)","type":"codeVoice"},{"text":" is shorter than threading a ","type":"text"},{"code":"ManagedIndex","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Re-reading the same parameter or column out of order.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Code generators that already track positions.","type":"text"}]}]}],"type":"unorderedList"}]}],"seeAlsoSections":[{"anchor":"Articles","title":"Articles","identifiers":["doc:\/\/LoomCore\/documentation\/LoomCore\/SafeInterpolation","doc:\/\/LoomCore\/documentation\/LoomCore\/ConcurrencyModel","doc:\/\/LoomCore\/documentation\/LoomCore\/StoringCustomTypes","doc:\/\/LoomCore\/documentation\/LoomCore\/QueryingJSON","doc:\/\/LoomCore\/documentation\/LoomCore\/FullTextSearch","doc:\/\/LoomCore\/documentation\/LoomCore\/TransactionsAndServices"],"generated":true}],"variants":[{"paths":["\/documentation\/loomcore\/indexconventions"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/LoomCore\/documentation\/LoomCore"]]},"sections":[],"abstract":[{"text":"How LoomCore handles SQLite’s asymmetric 1-based parameter \/ 0-based column indexing.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://LoomCore/documentation/LoomCore/ConcurrencyModel":{"type":"topic","abstract":[{"type":"text","text":"How LoomCore makes SQLite race-free without explicit locking."}],"url":"\/documentation\/loomcore\/concurrencymodel","title":"Concurrency and Actor Isolation","identifier":"doc:\/\/LoomCore\/documentation