{"metadata":{"role":"collectionGroup","title":"Index Conventions","roleHeading":"API Collection","modules":[{"name":"LoomCore"}]},"variants":[{"paths":["\/documentation\/loomcore\/indexconventions"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LoomCore\/documentation\/LoomCore\/IndexConventions"},"seeAlsoSections":[{"title":"Articles","identifiers":["doc:\/\/LoomCore\/documentation\/LoomCore\/SafeInterpolation","doc:\/\/LoomCore\/documentation\/LoomCore\/ConcurrencyModel","doc:\/\/LoomCore\/documentation\/LoomCore\/StoringCustomTypes","doc:\/\/LoomCore\/documentation\/LoomCore\/QueryingJSON","doc:\/\/LoomCore\/documentation\/LoomCore\/FullTextSearch","doc:\/\/LoomCore\/documentation\/LoomCore\/TransactionsAndServices"],"anchor":"Articles","generated":true}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"SQLite uses two different indexing conventions, and getting them wrong is a common source of subtle bugs:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Parameter binding is 1-based.","type":"text"}],"type":"strong"},{"text":" The leftmost ","type":"text"},{"code":"?","type":"codeVoice"},{"text":" in a prepared statement is index ","type":"text"},{"type":"codeVoice","code":"1"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Column extraction is 0-based.","type":"text"}]},{"type":"text","text":" The leftmost column in a result row is index "},{"code":"0","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"LoomCore preserves these conventions exactly rather than normalizing them, because flattening would hide which side of the API you are on and make off-by-one errors easier — not harder.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Parameter indices are 1-based:","try await db.exec(","  raw: \"INSERT INTO users (name, age) VALUES (?, ?)\",","  binder: { stmt in","    try \"Alice\".bind(to: stmt, at: 1)  \/\/ leftmost ?","    try 30.bind(to: stmt, at: 2)       \/\/ second ?","  }",")","","\/\/ Column indices are 0-based:","let rows = try await db.query(raw: \"SELECT name, age FROM users\") { stmt, _ in","  let name = try String.column(of: stmt, at: 0)  \/\/ leftmost column","  let age  = try Int.column(of: stmt, at: 1)     \/\/ second column","  return (name, age)","}"],"type":"codeListing"},{"text":"Avoiding off-by-one errors","anchor":"Avoiding-off-by-one-errors","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"For multi-column statements, the safest pattern is ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/ManagedIndex"},{"text":". It auto-increments around binds and column reads — for parameters it increments ","type":"text"},{"inlineContent":[{"text":"before","type":"text"}],"type":"emphasis"},{"text":" binding, so the first bind hits index 1; for columns it increments ","type":"text"},{"inlineContent":[{"text":"after","type":"text"}],"type":"emphasis"},{"text":" reading, so the first read hits index 0.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct User {","  let id: Int","  let name: String","  let email: String","  let age: Int","}","","let users = try await db.query(","  raw: \"SELECT id, name, email, age FROM users WHERE status = ?\",","  binder: { stmt, index in","    try \"active\".bind(to: stmt, at: &index)        \/\/ → param 1","  },","  stepper: { stmt, index, stop in","    let id    = try Int.column(of: stmt, at: &index)     \/\/ → column 0","    let name  = try String.column(of: stmt, at: &index)  \/\/ → column 1","    let email = try String.column(of: stmt, at: &index)  \/\/ → column 2","    let age   = try Int.column(of: stmt, at: &index)     \/\/ → column 3","    return User(id: id, name: name, email: email, age: age)","  }",")"]},{"type":"paragraph","inlineContent":[{"text":"When you add or remove a column, the indices shift automatically. There are no magic numbers to renumber.","type":"text"}]},{"text":"When to use raw indices","type":"heading","anchor":"When-to-use-raw-indices","level":3},{"type":"paragraph","inlineContent":[{"text":"Raw indices (","type":"text"},{"code":"Int32","type":"codeVoice"},{"text":") are still useful for:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Reading a single column — ","type":"text"},{"code":"try String.column(of: stmt, at: 0)","type":"codeVoice"},{"text":" is shorter than threading a ","type":"text"},{"code":"ManagedIndex","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Re-reading the same parameter or column out of order."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Code generators that already track positions.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"abstract":[{"text":"How LoomCore handles SQLite’s asymmetric 1-based parameter \/ 0-based column indexing.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/LoomCore\/documentation\/LoomCore"]]},"kind":"article","topicSections":[{"identifiers":["doc:\/\/LoomCore\/documentation\/LoomCore\/ManagedIndex","doc:\/\/LoomCore\/documentation\/LoomCore\/Bindable\/bind(to:value:at:)-8hkdq","doc:\/\/LoomCore\/documentation\/LoomCore\/Bindable\/column(of:at:)-4waew"],"anchor":"Topics"}],"references":{"doc://LoomCore/documentation/LoomCore":{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore","abstract":[{"text":"A type-safe SQLite wrapper for Swift 6+ built on actor isolation.","type":"text"}],"kind":"symbol","type":"topic","title":"LoomCore","role":"collection","url":"\/documentation\/loomcore"},"doc: