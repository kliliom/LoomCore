{"metadata":{"modules":[{"name":"LoomCore"}],"title":"Querying JSON","role":"collectionGroup","roleHeading":"API Collection"},"identifier":{"url":"doc:\/\/LoomCore\/documentation\/LoomCore\/QueryingJSON","interfaceLanguage":"swift"},"kind":"article","topicSections":[{"identifiers":["doc:\/\/LoomCore\/documentation\/LoomCore\/JSONPath","doc:\/\/LoomCore\/documentation\/LoomCore\/JSONBindable","doc:\/\/LoomCore\/documentation\/LoomCore\/JSONExtract","doc:\/\/LoomCore\/documentation\/LoomCore\/JSONAccessExpression","doc:\/\/LoomCore\/documentation\/LoomCore\/JSONAssignment","doc:\/\/LoomCore\/documentation\/LoomCore\/JSONModify","doc:\/\/LoomCore\/documentation\/LoomCore\/JSONEach","doc:\/\/LoomCore\/documentation\/LoomCore\/JSONTree"],"anchor":"Topics"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"SQLite ships a complete JSON toolkit — "},{"code":"json_extract","type":"codeVoice"},{"text":", the ","type":"text"},{"code":"->","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"->>","type":"codeVoice"},{"type":"text","text":" operators, "},{"code":"json_set","type":"codeVoice"},{"type":"text","text":", aggregates, and the "},{"code":"json_each","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"json_tree","type":"codeVoice"},{"type":"text","text":" table-valued functions — and every OS version LoomCore supports includes it. This article shows the typed expression DSL over those functions. For how JSON gets "},{"type":"emphasis","inlineContent":[{"text":"into","type":"text"}]},{"type":"text","text":" a column in the first place, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/StoringCustomTypes"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/JSONBindable"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The examples below assume a table of users whose ","type":"text"},{"type":"codeVoice","code":"profile"},{"text":" column holds a JSON document such as ","type":"text"},{"type":"codeVoice","code":"{\"displayName\":\"Alice\",\"age\":30,\"address\":{\"city\":\"Vienna\"},\"tags\":[\"swift\",\"sql\"]}"},{"text":".","type":"text"}]},{"type":"heading","level":3,"text":"JSON paths","anchor":"JSON-paths"},{"inlineContent":[{"type":"text","text":"Every function that addresses part of a document takes a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/JSONPath"},{"text":" — ","type":"text"},{"code":"$","type":"codeVoice"},{"text":" is the document root, ","type":"text"},{"code":"$.address.city","type":"codeVoice"},{"text":" a nested member, ","type":"text"},{"code":"$.tags[0]","type":"codeVoice"},{"text":" an array element, and ","type":"text"},{"code":"$.\"key with spaces\"","type":"codeVoice"},{"text":" a quoted key. Paths are usually written as string literals:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let profile = ColumnExpression<String>(\"profile\")","let city = profile.jsonValue(\"$.address.city\", as: String.self)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Paths render into the SQL as single-quoted literals, not bound parameters. This is deliberate: SQLite matches an expression index on ","type":"text"},{"code":"json_extract(\"profile\", '$.age')","type":"codeVoice"},{"text":" only when the path is a literal token, so binding paths would silently turn indexed JSON lookups into table scans. The trade-offs are that a path is inlined like an identifier — treat it as trusted input, like a column name — and that statements differing only in their paths are distinct entries in the prepared-statement cache.","type":"text"}]},{"type":"heading","level":3,"text":"Extracting values","anchor":"Extracting-values"},{"inlineContent":[{"type":"text","text":"Extraction states the expected Swift type up front, because a JSON node can decode to any storage class and LoomCore’s column reads are strictly checked:"}],"type":"paragraph"},{"syntax":"swift","code":["let profile = ColumnExpression<String>(\"profile\")","","let age = profile.jsonValue(\"$.age\", as: Int.self)  \/\/ (\"profile\"->>'$.age')","let name = profile.jsonExtract(\"$.displayName\", as: String.self)  \/\/ JSON_EXTRACT(…)","","let adults = try await db.query(\"SELECT \\(name) FROM users WHERE \\(age >= 18)\") { stmt, _ in","  try String?.column(of: stmt, at: 0)","}"],"type":"codeListing"},{"inlineContent":[{"text":"Results are optional — a NULL document or a path that selects nothing yields NULL. ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Expression\/jsonValue(_:as:)","isActive":true,"type":"reference"},{"text":" (the ","type":"text"},{"code":"->>","type":"codeVoice"},{"text":" operator) returns plain SQL values; ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Expression\/jsonFragment(_:)","isActive":true,"type":"reference"},{"text":" (the ","type":"text"},{"code":"->","type":"codeVoice"},{"text":" operator) returns the selected node ","type":"text"},{"inlineContent":[{"type":"text","text":"as JSON text"}],"type":"emphasis"},{"text":", so string nodes keep their quotes and the result chains:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let profile = ColumnExpression<String>(\"profile\")","let city = profile.jsonFragment(\"$.address\").jsonValue(\"$.city\", as: String.self)"]},{"inlineContent":[{"text":"Inspect documents with ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Expression\/jsonType(_:)","isActive":true,"type":"reference"},{"text":" (type name at a path), ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Expression\/jsonValid()","isActive":true,"type":"reference"},{"text":", and ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Expression\/jsonArrayLength(_:)","isActive":true,"type":"reference"},{"text":"; locate the syntax error in a broken document with ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Expression\/jsonErrorPosition()","isActive":true,"type":"reference"},{"text":" (SQLite 3.42+, iOS 17\/macOS 14).","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Modifying documents","anchor":"Modifying-documents"},{"inlineContent":[{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Expression\/jsonSet(_:_:)","isActive":true,"type":"reference"},{"text":" overwrites or creates, ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Expression\/jsonInsert(_:_:)","isActive":true,"type":"reference"},{"text":" only creates, and ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Expression\/jsonReplace(_:_:)","isActive":true,"type":"reference"},{"text":" only overwrites. Each takes ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/JSONAssignment","isActive":true,"type":"reference"},{"text":" pairs, and the choice of factory matters: SQLite treats a bound TEXT argument as a JSON ","type":"text"},{"inlineContent":[{"type":"text","text":"string"}],"type":"emphasis"},{"text":", so a nested document must be wrapped.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct Address: Codable, JSONBindable {","  let city: String","}","","let profile = ColumnExpression<String>(\"profile\")","try await db.exec(","  \"\"\"","  UPDATE users SET profile = \\(profile.jsonSet(","    .value(\"$.displayName\", \"Alice\"),","    .json(\"$.address\", Address(city: \"Vienna\"))","  ))","  \"\"\"",")"]},{"inlineContent":[{"code":".value","type":"codeVoice"},{"text":" binds scalars — numbers, strings, booleans — directly; ","type":"text"},{"code":".json","type":"codeVoice"},{"text":" wraps the bound text in ","type":"text"},{"code":"JSON(?)","type":"codeVoice"},{"text":" so a ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/JSONBindable","isActive":true,"type":"reference"},{"type":"text","text":" nests as a real object rather than a string. Assigning a "},{"code":"nil","type":"codeVoice"},{"text":" optional through ","type":"text"},{"code":".value","type":"codeVoice"},{"type":"text","text":" stores JSON "},{"code":"null","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Delete nodes with "},{"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Expression\/jsonRemove(_:_:)","isActive":true},{"type":"text","text":", and merge whole documents with "},{"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Expression\/jsonPatch(_:)","isActive":true},{"type":"text","text":" (RFC 7396: patch keys overwrite, "},{"code":"null","type":"codeVoice"},{"type":"text","text":" removes). Unlike "},{"code":"jsonSet","type":"codeVoice"},{"type":"text","text":" values, a "},{"code":"jsonPatch","type":"codeVoice"},{"type":"text","text":" argument needs no wrapping — both sides are parsed as JSON, so passing a "},{"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/JSONBindable","isActive":true},{"type":"text","text":" directly is exactly right."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"Building-and-aggregating","text":"Building and aggregating"},{"inlineContent":[{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/jsonArray(_:)","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/jsonObject(_:)"},{"type":"text","text":" construct documents in the SELECT list; "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Expression\/jsonGroupArray()"},{"text":" and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/jsonGroupObject(name:value:)"},{"type":"text","text":" aggregate grouped rows. All four are non-optional: empty input yields "},{"code":"'[]'","type":"codeVoice"},{"type":"text","text":" or "},{"code":"'{}'","type":"codeVoice"},{"type":"text","text":", and NULL inputs become JSON "},{"code":"null","type":"codeVoice"},{"type":"text","text":" members."}],"type":"paragraph"},{"code":["let author = ColumnExpression<String>(\"author\")","let title = ColumnExpression<String>(\"title\")","let shelves = try await db.query(","  \"SELECT \\(author), \\(title.jsonGroupArray()) FROM books GROUP BY \\(author)\"",") { stmt, _ in","  (try String.column(of: stmt, at: 0), try String.column(of: stmt, at: 1))","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The TEXT-is-a-string rule applies here too: to nest a column that already holds JSON, wrap it — "},{"code":"jsonArray(tags.json())","type":"codeVoice"},{"type":"text","text":", not "},{"code":"jsonArray(tags)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"Iterating-with-JSONEACH-and-JSONTREE","text":"Iterating with JSON_EACH and JSON_TREE"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/JSONEach"},{"type":"text","text":" yields one row per element of an array or object; "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/JSONTree"},{"type":"text","text":" recurses into nested containers. Both are FROM-clause fragments — interpolate them after the tables and read rows through their typed column handles:"}],"type":"paragraph"},{"code":["let userID = ColumnExpression<Int64>(\"id\", of: \"users\")","let profile = ColumnExpression<String>(\"profile\", of: \"users\")","let tag = JSONEach(profile, \"$.tags\")","","\/\/ Users tagged \"swift\" — one row per (user, tag) pair, filtered.","let swiftUsers = try await db.query(","  \"SELECT \\(userID) FROM users, \\(tag) WHERE \\(tag.value(as: String.self) == \"swift\")\"",") { stmt, _ in","  try Int64.column(of: stmt, at: 0)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"key","type":"codeVoice"},{"type":"text","text":", "},{"code":"value","type":"codeVoice"},{"type":"text","text":", and "},{"code":"atom","type":"codeVoice"},{"type":"text","text":" take "},{"code":"as:","type":"codeVoice"},{"type":"text","text":" because their storage class varies per row (array keys are integers, object keys are strings); "},{"code":"type","type":"codeVoice"},{"type":"text","text":", "},{"code":"id","type":"codeVoice"},{"type":"text","text":", "},{"code":"fullkey","type":"codeVoice"},{"type":"text","text":", "},{"code":"path","type":"codeVoice"},{"type":"text","text":" — and "},{"code":"parent","type":"codeVoice"},{"type":"text","text":" on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/JSONTree"},{"type":"text","text":" — are fixed. Two things to watch: qualify your own columns when names collide ("},{"code":"json_each","type":"codeVoice"},{"type":"text","text":" exposes its own "},{"code":"id","type":"codeVoice"},{"type":"text","text":"), and pass "},{"code":"alias:","type":"codeVoice"},{"type":"text","text":" when the same function appears twice in one query."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"JSONB","text":"JSONB"},{"inlineContent":[{"type":"text","text":"SQLite 3.45 added JSONB, a compact binary encoding that skips re-parsing on every access. It ships with iOS 18, macOS 15, macCatalyst 18, tvOS 18, watchOS 11, and visionOS 2, so the "},{"code":"jsonb","type":"codeVoice"},{"type":"text","text":"-prefixed variants — "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Expression\/jsonb()"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Expression\/jsonbSet(_:_:)"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/jsonbArray(_:)"},{"type":"text","text":", and friends — are annotated "},{"code":"@available","type":"codeVoice"},{"type":"text","text":" for those versions and return "},{"code":"Data","type":"codeVoice"},{"type":"text","text":" (BLOB) instead of "},{"code":"String","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["let profile = ColumnExpression<String>(\"profile\")","if #available(iOS 18.0, macOS 15.0, macCatalyst 18.0, tvOS 18.0, watchOS 11.0, visionOS 2.0, *) {","  try await db.exec(\"UPDATE users SET profile = \\(profile.jsonb())\")","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Every text-level function accepts JSONB input transparently on those OS versions, so a column can be migrated to JSONB without touching the queries that read it — with one exception: the one-argument "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Expression\/jsonValid()"},{"type":"text","text":" accepts only JSON text and reports JSONB as invalid. Validate migrated or mixed-storage columns with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Expression\/jsonValid(_:)"},{"type":"text","text":", e.g. "},{"type":"codeVoice","code":"data.jsonValid([.json, .jsonb])"},{"type":"text","text":". JSONB is an internal SQLite format: store it and query it, but do not parse the bytes outside SQLite. There is no "},{"type":"codeVoice","code":"jsonb_each"},{"type":"text","text":" — "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/JSONEach"},{"type":"text","text":" already accepts JSONB input."}],"type":"paragraph"}]}],"seeAlsoSections":[{"anchor":"Articles","title"