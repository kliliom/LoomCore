ext"},{"code":"Value?","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","type":"topic","title":"JSONExtract","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"JSONExtract","kind":"identifier"}],"role":"symbol","url":"\/documentation\/loomcore\/jsonextract"},"doc://LoomCore/documentation/LoomCore":{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore","abstract":[{"text":"A type-safe SQLite wrapper for Swift 6+ built on actor isolation.","type":"text"}],"kind":"symbol","type":"topic","title":"LoomCore","role":"collection","url":"\/documentation\/loomcore"},"doc://LoomCore/documentation/LoomCore/jsonGroupObject(name:value:)":{"url":"\/documentation\/loomcore\/jsongroupobject(name:value:)","role":"symbol","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/jsonGroupObject(name:value:)","title":"jsonGroupObject(name:value:)","type":"topic","abstract":[{"type":"text","text":"Aggregates grouped rows into a JSON object via SQL "},{"code":"JSON_GROUP_OBJECT()","type":"codeVoice"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"jsonGroupObject"},{"kind":"text","text":"("},{"kind":"externalParam","text":"name"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:8LoomCore10ExpressionP","kind":"typeIdentifier","text":"Expression"},{"kind":"text","text":", "},{"kind":"externalParam","text":"value"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:8LoomCore10ExpressionP","kind":"typeIdentifier","text":"Expression"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:8LoomCore15JSONGroupObjectV","kind":"typeIdentifier","text":"JSONGroupObject"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":">"}],"kind":"symbol"},"doc://LoomCore/documentation/LoomCore/SafeInterpolation":{"url":"\/documentation\/loomcore\/safeinterpolation","role":"collectionGroup","title":"Safe SQL Interpolation","type":"topic","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/SafeInterpolation","abstract":[{"text":"When ","type":"text"},{"type":"codeVoice","code":"\\(value)"},{"text":" becomes a parameter, when it becomes literal text, and how to keep injection-prone surfaces small.","type":"text"}],"kind":"article"},"doc://LoomCore/documentation/LoomCore/JSONPath":{"url":"\/documentation\/loomcore\/jsonpath","role":"symbol","title":"JSONPath","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/JSONPath","type":"topic","abstract":[{"text":"A SQLite JSON path such as ","type":"text"},{"code":"$.user.name","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$[0]","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"$.\"key with spaces\"","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"JSONPath","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"JSONPath","kind":"identifier"}]},"doc://LoomCore/documentation/LoomCore/Expression/jsonRemove(_:_:)":{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Expression\/jsonRemove(_:_:)","type":"topic","abstract":[{"type":"text","text":"This document with the nodes at "},{"code":"paths","type":"codeVoice"},{"type":"text","text":" removed via SQL "},{"code":"JSON_REMOVE()","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"jsonRemove"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"JSONPath","preciseIdentifier":"s:8LoomCore8JSONPathV"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"JSONPath","preciseIdentifier":"s:8LoomCore8JSONPathV"},{"kind":"text","text":"...) -> "},{"kind":"typeIdentifier","text":"JSONRemove","preciseIdentifier":"s:8LoomCore10JSONRemoveV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},