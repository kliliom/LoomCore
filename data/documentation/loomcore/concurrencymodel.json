ore\/documentation\/LoomCore\/SQLiteResultCode\/interrupt","abstract":[{"type":"text","text":"Operation interrupted by "},{"type":"codeVoice","code":"sqlite3_interrupt()"},{"type":"text","text":"."}],"url":"\/documentation\/loomcore\/sqliteresultcode\/interrupt"},"doc://LoomCore/documentation/LoomCore/TransactionsAndServices":{"url":"\/documentation\/loomcore\/transactionsandservices","role":"collectionGroup","title":"Transactions and Services","type":"topic","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/TransactionsAndServices","abstract":[{"text":"Atomic operations, savepoint nesting, transaction gating, and lifecycle hooks for cache invalidation.","type":"text"}],"kind":"article"},"doc://LoomCore/documentation/LoomCore/QueryingJSON":{"url":"\/documentation\/loomcore\/queryingjson","role":"collectionGroup","title":"Querying JSON","type":"topic","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/QueryingJSON","abstract":[{"text":"Extract, filter, modify, build, and iterate JSON documents with typed expressions over SQLite’s JSON functions.","type":"text"}],"kind":"article"},"doc://LoomCore/documentation/LoomCore/Database":{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database","navigatorTitle":[{"text":"Database","kind":"identifier"}],"abstract":[{"text":"SQLite database connection serialized through ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/DatabaseActor","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Database","kind":"identifier"}],"title":"Database","url":"\/documentation\/loomcore\/database","kind":"symbol"},"doc://LoomCore/documentation/LoomCore/DatabaseActor":{"url":"\/documentation\/loomcore\/databaseactor","role":"symbol","title":"DatabaseActor","type":"topic","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/DatabaseActor","abstract":[{"text":"Global actor that serializes all SQLite access in LoomCore.","type":"text"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DatabaseActor","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"DatabaseActor","kind":"identifier"}]},"doc://LoomCore/documentation/LoomCore/StoringCustomTypes":{"url":"\/documentation\/loomcore\/storingcustomtypes","role":"collectionGroup","title":"Storing Custom Types","type":"topic","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/StoringCustomTypes","abstract":[{"text":"How ","type":"text"},{"type":"codeVoice","code":"Bindable"},{"text":" maps Swift types to SQLite storage, and how to extend it.","type":"text"}],"kind":"article"},"doc://LoomCore/documentation/LoomCore/IndexConventions":{"url":"\/documentation\/loomcore\/indexconventions","role":"collectionGroup","title":"Index Conventions","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/IndexConventions","type":"topic","abstract":[{"text":"How LoomCore handles SQLite’s asymmetric 1-based parameter \/ 0-based column indexing.","type":"text"}],"kind":"article"},"doc://LoomCore/documentation/LoomCore/StatementHandle":{"url":"\/documentation\/loomcore\/statementhandle","role":"symbol","title":"StatementHandle","type":"topic","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/StatementHandle","abstract":[{"text":"Owns a compiled SQLite statement and releases it when the handle goes out of scope.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StatementHandle","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"StatementHandle","kind":"identifier"}]},"doc://LoomCore/documentation/LoomCore/Database/directAccess(_:)":{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/directAccess(_:)","type":"topic","abstract":[{"type":"text","text":"Exposes the underlying "},{"type":"codeVoice","code":"sqlite3*"},{"type":"text","text":" handle for direct SQLite C API calls."