nd":"identifier","text":"Bindable"}],"abstract":[{"type":"text","text":"Type that can be bound as a SQLite statement parameter or extracted from a result column."}],"title":"Bindable","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Bindable","type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/loomcore\/bindable"},"doc://LoomCore/documentation/LoomCore/DatabaseActor":{"navigatorTitle":[{"kind":"identifier","text":"DatabaseActor"}],"url":"\/documentation\/loomcore\/databaseactor","abstract":[{"text":"Global actor that serializes all SQLite access in LoomCore.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"text":"DatabaseActor","kind":"identifier"}],"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/DatabaseActor","kind":"symbol","title":"DatabaseActor","role":"symbol"},"doc://LoomCore/documentation/LoomCore/StoringCustomTypes":{"abstract":[{"text":"How ","type":"text"},{"code":"Bindable","type":"codeVoice"},{"text":" maps Swift types to SQLite storage, and how to extend it.","type":"text"}],"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/StoringCustomTypes","title":"Storing Custom Types","type":"topic","role":"collectionGroup","kind":"article","url":"\/documentation\/loomcore\/storingcustomtypes"},"doc://LoomCore/documentation/LoomCore/IndexConventions":{"abstract":[{"text":"How LoomCore handles SQLite’s asymmetric 1-based parameter \/ 0-based column indexing.","type":"text"}],"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/IndexConventions","title":"Index Conventions","type":"topic","role":"collectionGroup","kind":"article","url":"\/documentation\/loomcore\/indexconventions"},"doc://LoomCore/documentation/LoomCore/LoomError":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LoomError"}],"navigatorTitle":[{"kind":"identifier","text":"LoomError"}],"abstract":[{"text":"Error type used throughout LoomCore, pairing a typed error code with a human-readable message.","type":"text"}],"title":"LoomError","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/LoomError","type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/loomcore\/loomerror"},"doc://LoomCore/documentation/LoomCore/Database/interrupt()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"interrupt","kind":"identifier"},{"text":"()","kind":"text"}],"abstract":[{"type":"text","text":"Interrupts the SQL statement currently executing on this connection."}],"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/interrupt()","title":"interrupt()","type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/loomcore\/database\/interrupt()"},"doc://LoomCore/documentation/LoomCore/TransactionsAndServices":{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/TransactionsAndServices","kind":"article","role":"collectionGroup","title":"Transactions and Services","type":"topic","url":"\/documentation\/loomcore\/transactionsandservices","abstract":[{"text":"Atomic operations, savepoint nesting, transaction gating, and lifecycle hooks for cache invalidation.","type":"text"}]},"doc://LoomCore/documentation/LoomCore/FullTextSearch":{"abstract":[{"type":"text","text":"Match, rank, and excerpt text with typed expressions over SQLite’s FTS5 extension."}],"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/FullTextSearch","title":"Full-Text Search","type":"topic","role":"collectionGroup","kind":"article","url":"\/documentation\/loomcore\/fulltextsearch"}}}