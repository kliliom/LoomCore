t"},{"text":"literal, but a hostile path can still select a different node than intended — and","type":"text"},{"text":" ","type":"text"},{"text":"through the mutating functions it can affect far more than one member: ","type":"text"},{"code":"\"$\"","type":"codeVoice"},{"text":" passed to","type":"text"},{"text":" ","type":"text"},{"code":"jsonSet","type":"codeVoice"},{"text":" replaces the whole document, and to ","type":"text"},{"code":"jsonRemove","type":"codeVoice"},{"text":" deletes it (yielding NULL).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"One consequence of literal rendering: statements differing only in their JSON paths are","type":"text"},{"text":" ","type":"text"},{"text":"distinct entries in the prepared-statement cache. That is the point (index matching), but","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"worth knowing if you generate many dynamic paths."}],"type":"paragraph"},{"text":"Validation","level":2,"anchor":"Validation","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Paths are validated at construction. Empty strings, strings containing a NUL byte (","type":"text"},{"code":"\\0","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"and strings not starting with ","type":"text"},{"code":"$","type":"codeVoice"},{"text":" trigger a precondition failure.","type":"text"}]}],"kind":"content"}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/LoomCore\/s23CustomStringConvertibleP","doc:\/\/LoomCore\/SQ","doc:\/\/LoomCore\/s43ExpressibleByExtendedGraphemeClusterLiteralP","doc:\/\/LoomCore\/s26ExpressibleByStringLiteralP","doc:\/\/LoomCore\/s33ExpressibleByUnicodeScalarLiteralP","doc:\/\/LoomCore\/SH","doc:\/\/LoomCore\/s8SendableP","doc:\/\/LoomCore\/s16SendableMetatypeP"],"type":"conformsTo"}],"metadata":{"externalID":"s:8LoomCore8JSONPathV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"