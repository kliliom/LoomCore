text":" replaces the whole document, and to "},{"type":"codeVoice","code":"jsonRemove"},{"type":"text","text":" deletes it (yielding NULL)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"One consequence of literal rendering: statements differing only in their JSON paths are"},{"type":"text","text":" "},{"type":"text","text":"distinct entries in the prepared-statement cache. That is the point (index matching), but"},{"type":"text","text":" "},{"type":"text","text":"worth knowing if you generate many dynamic paths."}],"type":"paragraph"},{"type":"heading","anchor":"Validation","text":"Validation","level":2},{"inlineContent":[{"type":"text","text":"Paths are validated at construction. Empty strings, strings containing a NUL byte ("},{"type":"codeVoice","code":"\\0"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"and strings not starting with "},{"type":"codeVoice","code":"$"},{"type":"text","text":" trigger a precondition failure."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"A SQLite JSON path such as "},{"type":"codeVoice","code":"$.user.name"},{"type":"text","text":", "},{"type":"codeVoice","code":"$[0]"},{"type":"text","text":", or "},{"type":"codeVoice","code":"$.\"key with spaces\""},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/LoomCore\/documentation\/LoomCore"]]},"kind":"symbol","topicSections":[{"anchor":"Initializers","generated":true,"identifiers":["doc:\/\/LoomCore\/documentation\/LoomCore\/JSONPath\/init(_:)","doc:\/\/LoomCore\/documentation\/LoomCore\/JSONPath\/init(stringLiteral:)"],"title":"Initializers"},{"anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/LoomCore\/documentation\/LoomCore\/JSONPath\/description","doc:\/\/LoomCore\/documentation\/LoomCore\/JSONPath\/path"],"title":"Instance Properties"},{"anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/LoomCore\/documentation\/LoomCore\/JSONPath\/Equatable-Implementations","doc:\