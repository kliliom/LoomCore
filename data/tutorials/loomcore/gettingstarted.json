{"identifier":{"url":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/tutorials\/loomcore\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[{"title":"Getting started with LoomCore","chapter":"Getting started","estimatedTimeInMinutes":15,"content":[{"inlineContent":[{"type":"text","text":"Build a small notes store: open a database, create a schema, insert rows safely, run queries, and group writes in a transaction. By the end you will have a working command-line app that exercises the core LoomCore API."}],"type":"paragraph"}],"kind":"hero"},{"kind":"tasks","tasks":[{"contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"inlineContent":[{"type":"text","text":"Every LoomCore program begins by opening a "},{"code":"Database","type":"codeVoice"},{"type":"text","text":". For a one-off script or an integration test, open one in memory; for a real app, point it at a file URL."}],"type":"paragraph"},{"inlineContent":[{"code":"Database.open(...)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Database.openInMemory()","type":"codeVoice"},{"type":"text","text":" are async because the SQLite handle is created on the global "},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/DatabaseActor","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}],"stepsSection":[{"type":"step","runtimePreview":null,"caption":[],"content":[{"inlineContent":[{"type":"text","text":"Create a Swift Package or app and add LoomCore to its dependencies."}],"type":"paragraph"}],"media":null,"code":"gs-01-package.swift"},{"type":"step","runtimePreview":null,"caption":[],"content":[{"type":"paragraph","inlineContent":[{"text":"Open an in-memory database. We will use this for the rest of the tutorial; the same code works against a file by calling ","type":"text"},{"code":"Database.open(url:)","type":"codeVoice"},{"text":" instead.","type":"text"}]}],"media":null,"code":"gs-02-open.swift"}],"anchor":"Open-a-database","title":"Open a database"},{"contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"LoomCore does not generate schema. You write the "},{"code":"CREATE TABLE","type":"codeVoice"},{"type":"text","text":" statement yourself with "},{"code":"db.exec(_:)","type":"codeVoice"},{"text":". SQL identifiers (table and column names) come from your own code, so it is safe to embed them with the literal SQL string.","type":"text"}]}]}],"stepsSection":[{"runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Add a "},{"code":"notes","type":"codeVoice"},{"text":" table with a primary key, a body, and a creation timestamp.","type":"text"}],"type":"paragraph"}],"type":"step","media":null,"caption":[],"code":"gs-03-schema.swift"},{"runtimePreview":null,"content":[{"inlineContent":[{"text":"Inspect the schema with ","type":"text"},{"code":"db.tableInfo(_:)","type":"codeVoice"},{"type":"text","text":" to confirm the columns landed as expected. This call runs a "},{"type":"codeVoice","code":"PRAGMA table_info"},{"type":"text","text":" and returns a typed array of "},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/ColumnInfo","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"type":"step","media":null,"caption":[],"code":"gs-04-introspect.swift"}],"anchor":"Define-a-schema","title":"Define a schema"},{"stepsSection":[{"runtimePreview":null,"caption":[],"code":"gs-05-insert.swift","media":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"Insert a single note. The interpolated "},{"code":"body","type":"codeVoice"},{"type":"text","text":" and "},{"code":"createdAt","type":"codeVoice"},{"text":" are bound as ","type":"text"},{"code":"?","type":"codeVoice"},{"type":"text","text":" parameters; the SQL the database actually sees is "},{"code":"INSERT INTO notes (body, created_at) VALUES (?, ?)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"runtimePreview":null,"caption":[],"code":"gs-06-rowid.swift","media":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Get back the auto-assigned ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" by wrapping the insert in ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/lastInsertedRowID(_:)","isActive":true,"type":"reference"},{"text":". The method returns the ROWID of the last insert performed inside the block, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" if the block inserted nothing.","type":"text"}]}]}],"title":"Insert rows safely","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"Interpolated values become parameters by default. The library binds them at execution time, so user input cannot break out of the SQL string. This is the key safety guarantee — you should reach for raw SQL concatenation only when binding genuinely cannot work (table names, etc.).","type":"text"}]}]}],"anchor":"Insert-rows-safely"},{"stepsSection":[{"runtimePreview":null,"caption":[],"code":"gs-07-query.swift","media":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"Read all notes ordered by creation time. Column extraction is "},{"inlineContent":[{"text":"0-based","type":"text"}],"type":"strong"},{"text":", so the leftmost column is index ","type":"text"},{"type":"codeVoice","code":"0"},{"text":".","type":"text"}],"type":"paragraph"}]},{"code":"gs-08-managed.swift","caption":[],"media":null,"runtimePreview":null,"content":[{"inlineContent":[{"text":"Use a managed index for clarity when there are several columns. The index auto-increments after each read, so adding or removing a column does not require renumbering.","type":"text"}],"type":"paragraph"}],"type":"step"}],"title":"Query with a stepper","anchor":"Query-with-a-stepper","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"inlineContent":[{"code":"db.query(_:stepper:)","type":"codeVoice"},{"type":"text","text":" runs a SELECT and calls your stepper closure once per row. The closure pulls columns out by index and returns whatever value belongs in the result array."}],"type":"paragraph"}]}]},{"anchor":"Group-writes-in-a-transaction","title":"Group writes in a transaction","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"inlineContent":[{"text":"Two related writes that should either both succeed or both be rolled back belong in a transaction. The block is async, receives the database it runs on, and may suspend freely — LoomCore keeps other tasks’ operations out of the transaction until it ends. If the closure throws, LoomCore rolls back automatically and re-throws the error.","type":"text"}],"type":"paragraph"}]}],"stepsSection":[{"content":[{"inlineContent":[{"text":"Move a note from one folder to another by deleting and re-inserting in a single transaction.","type":"text"}],"type":"paragraph"}],"caption":[],"media":null,"code":"gs-09-transaction.swift","runtimePreview":null,"type":"step"},{"content":[{"inlineContent":[{"type":"text","text":"Watch what happens when the closure throws — the row is "},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" removed because the rollback undoes the delete."}],"type":"paragraph"}],"caption":[],"media":null,"code":"gs-10-rollback.swift","runtimePreview":null,"type":"step"}]}]},{"anchor":"Check-Your-Understanding","kind":"assessments","assessments":[{"choices":[{"isCorrect":true,"content":[{"inlineContent":[{"code":"1","type":"codeVoice"}],"type":"paragraph"}],"justification":[{"type":"paragraph","inlineContent":[{"text":"Parameter binding is 1-based. The leftmost ","type":"text"},{"code":"?","type":"codeVoice"},{"text":" is index ","type":"text"},{"code":"1","type":"codeVoice"},{"text":".","type":"text"}]}]},{"isCorrect":false,"content":[{"inlineContent":[{"code":"0","type":"codeVoice"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"text":"Column extraction is 0-based, but parameter binding is 1-based — the two are intentionally different.","type":"text"}],"type":"paragraph"}]},{"justification":[{"inlineContent":[{"text":"Negative indices are not valid in SQLite parameter binding.","type":"text"}],"type":"paragraph"}],"isCorrect":false,"content":[{"inlineContent":[{"code":"-1","type":"codeVoice"}],"type":"paragraph"}]}],"content":[],"title":[{"inlineContent":[{"text":"Which index does SQLite use for the leftmost parameter (","type":"text"},{"type":"codeVoice","code":"?"},{"text":")?","type":"text"}],"type":"paragraph"}],"type":"multiple-choice"},{"title":[{"inlineContent":[{"text":"Which interpolation produces a parameter (","type":"text"},{"type":"codeVoice","code":"?"},{"text":") rather than literal text?","type":"text"}],"type":"paragraph"}],"content":[],"type":"multiple-choice","choices":[{"isCorrect":true,"content":[{"type":"paragraph","inlineContent":[{"code":"\"WHERE id = \\(id)\"","type":"codeVoice"}]}],"justification":[{"type":"paragraph","inlineContent":[{"text":"The default mode is ","type":"text"},{"code":".bind","type":"codeVoice"},{"text":", so the value is sent as a parameter.","type":"text"}]}]},{"isCorrect":false,"content":[{"type":"paragraph","inlineContent":[{"code":"\"WHERE id = \\(id, mode: .raw)\"","type":"codeVoice"}]}],"justification":[{"type":"paragraph","inlineContent":[{"code":".raw","type":"codeVoice"},{"text":" pastes the value directly into the SQL string. Use it only for trusted identifiers.","type":"text"}]}]}]},{"title":[{"inlineContent":[{"text":"What happens if the closure passed to ","type":"text"},{"type":"codeVoice","code":"db.transaction { db in … }"},{"text":" throws an error?","type":"text"}],"type":"paragraph"}],"content":[],"type":"multiple-choice","choices":[{"isCorrect":true,"content":[{"type":"paragraph","inlineContent":[{"text":"The transaction is rolled back and the error is re-thrown.","type":"text"}]}],"justification":[{"type":"paragraph","inlineContent":[{"text":"A throwing block triggers ","type":"text"},{"code":"ROLLBACK","type":"codeVoice"},{"text":"; the caller sees the original error.","type":"text"}]}]},{"isCorrect":false,"content":[{"type":"paragraph","inlineContent":[{"text":"The transaction is committed and the error is swallowed.","type":"text"}]}],"justification":[{"type":"paragraph","inlineContent":[{"text":"That would defeat the purpose of a transaction.","type":"text"}]}]},{"isCorrect":false,"content":[{"type":"paragraph","inlineContent":[{"text":"The database is closed.","type":"text"}]}],"justification":[{"type":"paragraph","inlineContent":[{"text":"The connection stays open; only the in-flight transaction is rolled back.","type":"text"}]}]}]}]},{"abstract":[{"text":"Build a small task tracker that uses ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/ColumnExpression","type":"reference"},{"text":" and the operator DSL for type-checked queries, stores per-task metadata as JSON via ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/JSONBindable","type":"reference"},{"text":", tunes SQLite for production with PRAGMA, and uses ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/Service","type":"reference"},{"text":" to invalidate an in-process cache on commit.","type":"text"}],"kind":"callToAction","title":"Expressions and services","action":{"isActive":true,"overridingTitle":"Get started","overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/ExpressionsAndServices","type":"reference"},"featuredEyebrow":"Tutorial"}],"kind":"project","hierarchy":{"modules":[{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/Getting-started","projects":[{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted","sections":[{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Open-a-database","kind":"task"},{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Define-a-schema","kind":"task"},{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Insert-rows-safely","kind":"task"},{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Query-with-a-stepper","kind":"task"},{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Group-writes-in-a-transaction","kind":"task"},{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Check-Your-Understanding","kind":"assessment"}]}]},{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/Expressions-and-services","projects":[{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/ExpressionsAndServices","sections":[{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/ExpressionsAndServices#Configure-the-database-for-production","kind":"task"},{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/ExpressionsAndServices#Model-rows-with-Codable","kind":"task"},{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/ExpressionsAndServices#Build-queries-with-ColumnExpression","kind":"task"},{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/ExpressionsAndServices#React-to-commits-with-services","kind":"task"},{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/ExpressionsAndServices#Check-Your-Understanding","kind":"assessment"}]}]}],"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore","paths":[["doc:\/\/LoomCore\/tutorials\/LoomCore","doc:\/\/LoomCore\/tutorials\/LoomCore\/$volume","doc:\/\/LoomCore\/tutorials\/LoomCore\/Getting-started"]]},"metadata":{"title":"Getting started with LoomCore","role":"project","category":"LoomCore","categoryPathComponent":"LoomCore"},"references":{"doc://LoomCore/documentation/LoomCore/JSONBindable":{"url":"\/documentation\/loomcore\/jsonbindable","navigatorTitle":[{"kind":"identifier","text":"JSONBindable"}],"abstract":[{"type":"text","text":"Opt-in JSON-as-"},{"type":"codeVoice","code":"TEXT"},{"type":"text","text":" storage for "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" types."}],"kind":"symbol","type":"topic","title":"JSONBindable","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONBindable"}],"role":"symbol","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/JSONBindable"},"doc://LoomCore/tutorials/LoomCore/Expressions-and-services":{"url":"\/tutorials\/loomcore\/expressions-and-services","role":"article","identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/Expressions-and-services","type":"topic","title":"Expressions and services","abstract":[],"kind":"article"},"doc://LoomCore/documentation/LoomCore/Database/Service":{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/Service","navigatorTitle":[{"text":"Service","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Base class for cross-cutting database services that hook into transaction lifecycle events."}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Service"}],"title":"Database.Service","url":"\/documentation\/loomcore\/database\/service","kind":"symbol"},"doc://LoomCore/tutorials/LoomCore/GettingStarted#Define-a-schema":{"identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Define-a-schema","abstract":[{"type":"text","text":"Build a small notes store: open a database, create a schema, insert rows safely, run queries, and group writes in a transaction. By the end you will have a working command-line app that exercises the core LoomCore API."}],"type":"section","role":"pseudoSymbol","title":"Define a schema","url":"\/tutorials\/loomcore\/gettingstarted#Define-a-schema","kind":"section"},"doc://LoomCore/tutorials/LoomCore/GettingStarted#Open-a-database":{"identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Open-a-database","abstract":[{"text":"Build a small notes store: open a database, create a schema, insert rows safely, run queries, and group writes in a transaction. By the end you will have a working command-line app that exercises the core LoomCore API.","type":"text"}],"type":"section","role":"pseudoSymbol","title":"Open a database","url":"\/tutorials\/loomcore\/gettingstarted#Open-a-database","kind":"section"},"gs-08-managed.swift":{"content":["import Foundation","import LoomCore","","struct Note {","    let id: Int","    let body: String","    let createdAt: Date","}","","@main","struct Notes {","    static func main() async throws {","        let db = try await Database.openInMemory()","        \/\/ ... schema and inserts elided ...","","        let notes: [Note] = try await db.query(","            raw: \"SELECT id, body, created_at FROM notes ORDER BY created_at\",","            stepper: { stmt, index, _ in","                Note(","                    id: try Int.column(of: stmt, at: &index),","                    body: try String.column(of: stmt, at: &index),","                    createdAt: try Date.column(of: stmt, at: &index)","                )","            }","        )","","        for note in notes {","            print(note)","        }","    }","}"],"fileName":"main.swift","fileType":"swift","syntax":"swift","type":"file","highlights":[{"line":4},{"line":5},{"line":6},{"line":7},{"line":8},{"line":9},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":27},{"line":28}],"identifier":"gs-08-managed.swift"},"doc://LoomCore/tutorials/LoomCore/ExpressionsAndServices":{"identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/ExpressionsAndServices","estimatedTime":"25min","type":"topic","abstract":[{"type":"text","text":"Build a small task tracker that uses "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/ColumnExpression"},{"type":"text","text":" and the operator DSL for type-checked queries, stores per-task metadata as JSON via "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/JSONBindable"},{"type":"text","text":", tunes SQLite for production with PRAGMA, and uses "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/Service"},{"type":"text","text":" to invalidate an in-process cache on commit."}],"role":"project","title":"Expressions and services","url":"\/tutorials\/loomcore\/expressionsandservices","kind":"project"},"gs-04-introspect.swift":{"fileName":"main.swift","identifier":"gs-04-introspect.swift","syntax":"swift","type":"file","fileType":"swift","content":["import Foundation","import LoomCore","","@main","struct Notes {","    static func main() async throws {","        let db = try await Database.openInMemory()","","        try await db.exec(","            \"\"\"","            CREATE TABLE notes (","              id INTEGER PRIMARY KEY,","              body TEXT NOT NULL,","              created_at REAL NOT NULL","            )","            \"\"\"","        )","","        for column in try await db.tableInfo(\"notes\") {","            print(\"\\(column.name): \\(column.type)\\(column.notNull ? \" NOT NULL\" : \"\")\")","        }","        \/\/ id: INTEGER","        \/\/ body: TEXT NOT NULL","        \/\/ created_at: REAL NOT NULL","    }","}"],"highlights":[{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24}]},"doc://LoomCore/documentation/LoomCore/Database/ColumnInfo":{"url":"\/documentation\/loomcore\/database\/columninfo","navigatorTitle":[{"text":"ColumnInfo","kind":"identifier"}],"abstract":[{"text":"Information about a single column in a table.","type":"text"}],"kind":"symbol","type":"topic","title":"D