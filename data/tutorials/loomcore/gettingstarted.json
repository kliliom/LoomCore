r":"doc:\/\/LoomCore\/documentation\/LoomCore\/ColumnExpression"},{"type":"text","text":" and the operator DSL for type-checked queries, stores per-task metadata as JSON via "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/JSONBindable"},{"type":"text","text":", tunes SQLite for production with PRAGMA, and uses "},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/Service","type":"reference","isActive":true},{"type":"text","text":" to invalidate an in-process cache on commit."}],"type":"section","role":"pseudoSymbol","title":"Model rows with Codable","url":"\/tutorials\/loomcore\/expressionsandservices#Model-rows-with-Codable","kind":"section"},"doc://LoomCore/tutorials/LoomCore/GettingStarted#Query-with-a-stepper":{"identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Query-with-a-stepper","type":"section","abstract":[{"type":"text","text":"Build a small notes store: open a database, create a schema, insert rows safely, run queries, and group writes in a transaction. By the end you will have a working command-line app that exercises the core LoomCore API."}],"role":"pseudoSymbol","title":"Query with a stepper","url":"\/tutorials\/loomcore\/gettingstarted#Query-with-a-stepper","kind":"section"},"gs-05-insert.swift":{"content":["import Foundation","import LoomCore","","@main","struct Notes {","    static func main() async throws {","        let db = try await Database.openInMemory()","","        try await db.exec(","            \"\"\"","            CREATE TABLE notes (","              id INTEGER PRIMARY KEY,","              body TEXT NOT NULL,","              created_at REAL NOT NULL","            )","            \"\"\"","        )","","        let body = \"Pick up groceries\"","        let createdAt = Date()","        try await db.exec(","            \"INSERT INTO notes (body, created_at) VALUES (\\(body), \\(createdAt))\"","        )","    }","}"],"fileType":"swift","fileName":"main.swift","syntax":"swift","type":"file","highlights":[{"line":19},{"line":20},{"line":21},{"line":22},{"line":23}],"identifier":"gs-05-insert.swift"},"doc://LoomCore/tutorials/LoomCore/GettingStarted":{"type":"topic","title":"Getting started with LoomCore","estimatedTime":"15min","kind":"project","role":"project","identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted","abstract":[{"type":"text","text":"Build a small notes store: open a database, create a schema, insert rows safely, run queries, and group writes in a transaction. By the end you will have a working command-line app that exercises the core LoomCore API."}],"url":"\/tutorials\/loomcore\/gettingstarted"},"gs-06-rowid.swift":{"fileName":"main.swift","identifier":"gs-06-rowid.swift","syntax":"swift","fileType":"swift","type":"file","content":["import Foundation","import LoomCore","","@main","struct Notes {","    static func main() async throws {","        let db = try await Database.openInMemory()","","        try await db.exec(","            \"\"\"","            CREATE TABLE notes (","              id INTEGER PRIMARY KEY,","              body TEXT NOT NULL,","              created_at REAL NOT NULL","            )","            \"\"\"","        )","","        let body = \"Pick up groceries\"","        let createdAt = Date()","        let newID = try await db.lastInsertedRowID {","            try await db.exec(","                \"INSERT INTO notes (body, created_at) VALUES (\\(body), \\(createdAt))\"","            )","        }","        if let newID {","            print(\"Inserted note with id \\(newID)\")","        }","    }","}"],"highlights":[{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26},{"line":27},{"line":28}]},"gs-02-open.swift":{"content":["import Foundation","import LoomCore","","@main","struct Notes {","    static func main() async throws {","        let db = try await Database.openInMemory()","    }","}"],"fileType":"swift","fileName":"main.swift","syntax":"swift