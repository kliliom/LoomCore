 safely","abstract":[{"text":"Build a small notes store: open a database, create a schema, insert rows safely, run queries, and group writes in a transaction. By the end you will have a working command-line app that exercises the core LoomCore API.","type":"text"}],"url":"\/tutorials\/loomcore\/gettingstarted#Insert-rows-safely","identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Insert-rows-safely","kind":"section"},"gs-10-rollback.swift":{"fileName":"main.swift","content":["import Foundation","import LoomCore","","struct MoveCancelled: Error {}","","@main","struct Notes {","    static func main() async throws {","        let db = try await Database.openInMemory()","        \/\/ ... schema setup elided ...","","        let noteID = 1","","        do {","            try await db.transaction { db in","                try await db.exec(\"DELETE FROM notes WHERE id = \\(noteID)\")","                \/\/ Simulate a validation failure mid-transaction.","                throw MoveCancelled()","            }","        } catch is MoveCancelled {","            \/\/ The DELETE was rolled back; the row is still there.","            let count = try await db.query(\"SELECT COUNT(*) FROM notes WHERE id = \\(noteID)\") { stmt, _ in","                try Int.column(of: stmt, at: 0)","            }","            assert(count.first == 1)","        }","    }","}"],"type":"file","identifier":"gs-10-rollback.swift","syntax":"swift","highlights":[{"line":4},{"line":5},{"line":10},{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25}],"fileType":"swift"},"doc://LoomCore/tutorials/LoomCore/ExpressionsAndServices#React-to-commits-with-services":{"abstract":[{"text":"Build a small task tracker that uses ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/ColumnExpression"},{"text":" and the operator DSL for type-checked queries, s