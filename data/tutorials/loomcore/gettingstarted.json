rue},{"type":"text","text":" to invalidate an in-process cache on commit."}],"role":"pseudoSymbol","title":"React to commits with services","url":"\/tutorials\/loomcore\/expressionsandservices#React-to-commits-with-services","kind":"section"},"gs-07-query.swift":{"content":["import Foundation","import LoomCore","","@main","struct Notes {","    static func main() async throws {","        let db = try await Database.openInMemory()","        \/\/ ... schema and inserts elided ...","","        let notes = try await db.query(\"SELECT id, body FROM notes ORDER BY created_at\") { stmt, _ in","            let id = try Int.column(of: stmt, at: 0)","            let body = try String.column(of: stmt, at: 1)","            return (id, body)","        }","","        for (id, body) in notes {","            print(\"\\(id): \\(body)\")","        }","    }","}"],"fileType":"swift","fileName":"main.swift","syntax":"swift","type":"file","highlights":[{"line":8},{"line":10},{"line":11},{"line":12},{"line":13},{"line":15},{"line":16},{"line":17}],"identifier":"gs-07-query.swift"},"doc://LoomCore/tutorials/LoomCore/GettingStarted#Check-Your-Understanding":{"url":"\/tutorials\/loomcore\/gettingstarted#Check-Your-Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"title":"Check Your Understanding","identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Check-Your-Understanding","type":"link"},"doc://LoomCore/tutorials/LoomCore/ExpressionsAndServices#Build-queries-with-ColumnExpression":{"url":"\/tutorials\/loomcore\/expressionsandservices#Build-queries-with-ColumnExpression","role":"pseudoSymbol","title":"Build queries with ColumnExpression","type":"section","identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/ExpressionsAndServices#Build-queries-with-ColumnExpression","abstract":[{"text":"Build a small task tracker that uses ","type":"text"},{"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/ColumnExpression","isActive":true},{"text":" and the operator DSL for type-checked queries, stores per-task metadata as JSON via ","type":"text"},{"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/JSONBindable","isActive":true},{"type":"text","text":", tunes SQLite for production with PRAGMA, and uses "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/Service"},{"type":"text","text":" to invalidate an in-process cache on commit."}],"kind":"section"},"doc://LoomCore/tutorials/LoomCore/ExpressionsAndServices#Configure-the-database-for-production":{"url":"\/tutorials\/loomcore\/expressionsandservices#Configure-the-database-for-production","role":"pseudoSymbol","title":"Configure the database for production","type":"section","identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/ExpressionsAndServices#Configure-the-database-for-production","abstract":[{"type":"text","text":"Build a small task tracker that uses "},{"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/ColumnExpression","isActive":true},{"type":"text","text":" and the operator DSL for type-checked queries, stores per-task metadata as JSON via "},{"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/JSONBindable","isActive":true},{"type":"text","text":", tunes SQLite for production with PRAGMA, and uses "},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/Service","type":"reference","isActive":true},{"type":"text","text":" to invalidate an in-process cache on commit."}],"kind":"section"},"gs-03-schema.swift":{"identifier":"gs-03-schema.swift","fileName":"main.swift","fileType":"swift","syntax":"swift","type":"file","content":["import Foundation","import LoomCore","","@main","struct Notes {","    static func main() async throws {","        let db = try await Database.openInMemory()","","        try await db.exec(","            \"\"\"","            CREATE TABLE notes (","              id INTEGER PRIMARY KEY,","              body TEXT NOT NULL,","              created_at REAL NOT NULL","            )","            \"\"\"","        )","    }","}"],"highlights":[{"line":8},{"line":9},{"line":10},{"line":11},{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17}]},"doc://LoomCore/documentation/LoomCore/DatabaseActor":{"url":"\/documentation\/loomcore\/databaseactor","role":"symbol","title":"DatabaseActor","type":"topic","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/DatabaseActor","abstract":[{"text":"Global actor that serializes all SQLite access in LoomCore.","type":"text"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DatabaseActor","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"DatabaseActor","kind":"identifier"}]},"doc://LoomCore/tutorials/LoomCore/Getting-started":{"url":"\/tutorials\/loomcore\/getting-started","role":"article","title":"Getting started","type":"topic","identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/Getting-started","abstract":[],"kind":"article"},"gs-09-transaction.swift":{"content":["import Foundation","import LoomCore","","@main","struct Notes {","    static func main() async throws {","        let db = try await Database.openInMemory()","        \/\/ ... schema setup elided; assume `notes` and `folders` tables ...","","        let noteID = 1","        let body = \"Pick up the dry cleaning\"","        let targetFolderID = 2","        let createdAt = Date()","","        try await db.transaction { db in","            try await db.exec(\"DELETE FROM notes WHERE id = \\(noteID)\")","            try await db.exec(","                \"\"\"","                INSERT INTO notes (id, body, folder_id, created_at)","                VALUES (\\(noteID), \\(body), \\(targetFolderID), \\(createdAt))","                \"\"\"","            )","        }","    }","}"],"fileType":"swift","fileName":"main.swift","syntax":"swift","type":"file","highlights":[{"line":8},{"line":10},{"line":11},{"line":12},{"line":13},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22}],"identifier":"gs-09-transaction.swift"},"doc://LoomCore/tutorials/LoomCore/GettingStarted#Group-writes-in-a-transaction":{"url":"\/tutorials\/loomcore\/gettingstarted#Group-writes-in-a-transaction","role":"pseudoSymbol","title":"Group writes in a transaction","type":"section","identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Group-writes-in-a-transaction","abstract":[{"type":"text","text":"Build a small notes store: open a database, create a schema, insert rows safely, run queries, and group writes in a transaction. By the end you will have a working command-line app that exercises the core LoomCore API."}],"kind":"section"},"gs-10-rollback.swift":{"content":["import Foundation","import LoomCore","","struct MoveCancelled: Error {}","","@main","struct Notes {","    static func main() async throws {","        let db = try await Database.openInMemory()","        \/\/ ... schema setup elided ...","","        let noteID = 1","","        do {","            try await db.transaction { db in","                try await db.exec(\"DELETE FROM notes WHERE id = \\(noteID)\")","                \/\/ Simulate a validation failure mid-transaction.","                throw MoveCancelled()","            }","        } catch is MoveCancelled {","            \/\/ The DELETE was rolled back; the row is still there.","            let count = try await db.query(\"SELECT COUNT(*) FROM notes WHERE id = \\(noteID)\") { stmt, _ in","                try Int.column(of: stmt, at: 0)","            }","            assert(count.first == 1)","        }","    }","}"],"syntax":"swift","fileName":"main.swift","fileType":"swift","identifier":"gs-10-rollback.swift","type":"file","highlights":[{"line":4},{"line":5},{"line":10},{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25}]},"doc://LoomCore/documentation/LoomCore/Database/lastInsertedRowID(_:)":{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/lastInsertedRowID(_:)","type":"topic","abstract":[{"type":"text","text":"Captures the ROWID of the last row inserted by the given block."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lastInsertedRowID"},{"kind":"text","text":"(() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Int64","preciseIdentifier":"s:s5Int64V"},{"kind":"text","text":"?"}],"title":"lastInsertedRowID(_:)","url":"\/documentation\/loomcore\/database\/lastinsertedrowid(_:)","kind":"symbol"}}}