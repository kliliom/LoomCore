{"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/tutorials\/loomcore\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted"},"metadata":{"category":"LoomCore","categoryPathComponent":"LoomCore","role":"project","title":"Getting started with LoomCore"},"kind":"project","sections":[{"content":[{"inlineContent":[{"type":"text","text":"Build a small notes store: open a database, create a schema, insert rows safely, run queries, and group writes in a transaction. By the end you will have a working command-line app that exercises the core LoomCore API."}],"type":"paragraph"}],"chapter":"Getting started","title":"Getting started with LoomCore","estimatedTimeInMinutes":15,"kind":"hero"},{"tasks":[{"title":"Open a database","contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"Every LoomCore program begins by opening a "},{"type":"codeVoice","code":"Database"},{"type":"text","text":". For a one-off script or an integration test, open one in memory; for a real app, point it at a file URL."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"Database.open(...)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Database.openInMemory()"},{"type":"text","text":" are async because the SQLite handle is created on the global "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/DatabaseActor"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"anchor":"Open-a-database","stepsSection":[{"code":"gs-01-package.swift","runtimePreview":null,"type":"step","content":[{"inlineContent":[{"text":"Create a Swift Package or app and add LoomCore to its dependencies.","type":"text"}],"type":"paragraph"}],"media":null,"caption":[]},{"code":"gs-02-open.swift","runtimePreview":null,"type":"step","content":[{"inlineContent":[{"text":"Open an in-memory database. We will use this for the rest of the tutorial; the same code works against a file by calling ","type":"text"},{"code":"Database.open(url:)","type":"codeVoice"},{"text":" instead.","type":"text"}],"type":"paragraph"}],"media":null,"caption":[]}]},{"title":"Define a schema","contentSection":[{"kind":"contentAndMedia","content":[{"inlineContent":[{"text":"LoomCore does not generate schema. You write the ","type":"text"},{"code":"CREATE TABLE","type":"codeVoice"},{"text":" statement yourself with ","type":"text"},{"code":"db.exec(_:)","type":"codeVoice"},{"text":". SQL identifiers (table and column names) come from your own code, so it is safe to embed them with the literal SQL string.","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing"}],"anchor":"Define-a-schema","stepsSection":[{"code":"gs-03-schema.swift","runtimePreview":null,"type":"step","content":[{"inlineContent":[{"text":"Add a ","type":"text"},{"code":"notes","type":"codeVoice"},{"text":" table with a primary key, a body, and a creation timestamp.","type":"text"}],"type":"paragraph"}],"media":null,"caption":[]},{"code":"gs-04-introspect.swift","runtimePreview":null,"type":"step","content":[{"inlineContent":[{"text":"Inspect the schema with ","type":"text"},{"code":"db.tableInfo(_:)","type":"codeVoice"},{"text":" to confirm the columns landed as expected. This call runs a ","type":"text"},{"code":"PRAGMA table_info","type":"codeVoice"},{"text":" and returns a typed array of ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/ColumnInfo","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"media":null,"caption":[]}]},{"title":"Insert rows safely","contentSection":[{"kind":"contentAndMedia","content":[{"inlineContent":[{"text":"Interpolated values become parameters by default. The library binds them at execution time, so user input cannot break out of the SQL string. This is the key safety guarantee — you should reach for raw SQL concatenation only when binding genuinely cannot work (table names, etc.).","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing"}],"anchor":"Insert-rows-safely","stepsSection":[{"code":"gs-05-insert.swift","runtimePreview":null,"type":"step","content":[{"inlineContent":[{"text":"Insert a single note. The interpolated ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"createdAt","type":"codeVoice"},{"text":" are bound as ","type":"text"},{"code":"?","type":"codeVoice"},{"text":" parameters; the SQL the database actually sees is ","type":"text"},{"code":"INSERT INTO notes (body, created_at) VALUES (?, ?)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"media":null,"caption":[]},{"code":"gs-06-rowid.swift","runtimePreview":null,"type":"step","content":[{"inlineContent":[{"text":"Get back the auto-assigned ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" by wrapping the insert in ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/lastInsertedRowID(_:)","isActive":true,"type":"reference"},{"text":". The method returns the ROWID of the last insert performed inside the block, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if the block inserted nothing.","type":"text"}],"type":"paragraph"}],"media":null,"caption":[]}]},{"stepsSection":[{"media":null,"code":"gs-07-query.swift","type":"step","content":[{"inlineContent":[{"type":"text","text":"Read all notes ordered by creation time. Column extraction is "},{"inlineContent":[{"type":"text","text":"0-based"}],"type":"strong"},{"type":"text","text":", so the leftmost column is index "},{"type":"codeVoice","code":"0"},{"type":"text","text":"."}],"type":"paragraph"}],"runtimePreview":null,"caption":[]},{"code":"gs-08-managed.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a managed index for clarity when there are several columns. The index auto-increments after each read, so adding or removing a column does not require renumbering."}]}],"type":"step","runtimePreview":null,"caption":[],"media":null}],"contentSection":[{"mediaPosition":"trailing","content":[{"inlineContent":[{"type":"codeVoice","code":"db.query(_:stepper:)"},{"type":"text","text":" runs a SELECT and calls your stepper closure once per row. The closure pulls columns out by index and returns whatever value belongs in the result array."}],"type":"paragraph"}],"kind":"contentAndMedia"}],"title":"Query with a stepper","anchor":"Query-with-a-stepper"},{"title":"Group writes in a transaction","contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"Two related writes that should either both succeed or both be rolled back belong in a transaction. The block is async, receives the database it runs on, and may suspend freely — LoomCore keeps other tasks’ operations out of the transaction until it ends. If the closure throws, LoomCore rolls back automatically and re-throws the error."}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"anchor":"Group-writes-in-a-transaction","stepsSection":[{"caption":[],"code":"gs-09-transaction.swift","media":null,"runtimePreview":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"Move a note from one folder to another by deleting and re-inserting in a single transaction."}],"type":"paragraph"}]},{"runtimePreview":null,"code":"gs-10-rollback.swift","media":null,"content":[{"inlineContent":[{"type":"text","text":"Watch what happens when the closure throws — the row is "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" removed because the rollback undoes the delete."}],"type":"paragraph"}],"caption":[],"type":"step"}]}],"kind":"tasks"},{"anchor":"Check-Your-Understanding","kind":"assessments","assessments":[{"content":[],"title":[{"inlineContent":[{"text":"Which index does SQLite use for the leftmost parameter (","type":"text"},{"code":"?","type":"codeVoice"},{"text":")?","type":"text"}],"type":"paragraph"}],"choices":[{"isCorrect":true,"content":[{"inlineContent":[{"code":"1","type":"codeVoice"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"Parameter binding is 1-based. The leftmost "},{"code":"?","type":"codeVoice"},{"type":"text","text":" is index "},{"type":"codeVoice","code":"1"},{"type":"text","text":"."}],"type":"paragraph"}]},{"isCorrect":false,"content":[{"inlineContent":[{"code":"0","type":"codeVoice"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"Column extraction is 0-based, but parameter binding is 1-based — the two are intentionally different."}],"type":"paragraph"}]},{"isCorrect":false,"justification":[{"inlineContent":[{"text":"Negative indices are not valid in SQLite parameter binding.","type":"text"}],"type":"paragraph"}],"content":[{"inlineContent":[{"code":"-1","type":"codeVoice"}],"type":"paragraph"}]}],"type":"multiple-choice"},{"content":[],"title":[{"inlineContent":[{"text":"Which interpolation produces a parameter (","type":"text"},{"code":"?","type":"codeVoice"},{"text":") rather than literal text?","type":"text"}],"type":"paragraph"}],"choices":[{"isCorrect":true,"content":[{"inlineContent":[{"code":"\"WHERE id = \\(id)\"","type":"codeVoice"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"The default mode is "},{"type":"codeVoice","code":".bind"},{"type":"text","text":", so the value is sent as a parameter."}],"type":"paragraph"}]},{"isCorrect":false,"content":[{"inlineContent":[{"type":"codeVoice","code":"\"WHERE id = \\(id, mode: .raw)\""}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"codeVoice","code":".raw"},{"type":"text","text":" pastes the value directly into the SQL string. Use it only for trusted identifiers."}],"type":"paragraph"}]}],"type":"multiple-choice"},{"content":[],"title":[{"inlineContent":[{"text":"What happens if the closure passed to ","type":"text"},{"code":"db.transaction { db in … }","type":"codeVoice"},{"text":" throws an error?","type":"text"}],"type":"paragraph"}],"choices":[{"isCorrect":true,"content":[{"inlineContent":[{"type":"text","text":"The transaction is rolled back and the error is re-thrown."}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"A throwing block triggers "},{"type":"codeVoice","code":"ROLLBACK"},{"type":"text","text":"; the caller sees the original error."}],"type":"paragraph"}]},{"isCorrect":false,"content":[{"inlineContent":[{"type":"text","text":"The transaction is committed and the error is swallowed."}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"That would defeat the purpose of a transaction."}],"type":"paragraph"}]},{"isCorrect":false,"content":[{"inlineContent":[{"type":"text","text":"The database is closed."}],"type":"paragraph"}],"justification":[{"inlineContent":[{"type":"text","text":"The connection stays open; only the in-flight transaction is rolled back."}],"type":"paragraph"}]}],"type":"multiple-choice"}]},{"abstract":[{"text":"Build a small task tracker that uses ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/ColumnExpression","isActive":true,"type":"reference"},{"text":" and the operator DSL for type-checked queries, stores per-task metadata as JSON via ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/JSONBindable","isActive":true,"type":"reference"},{"text":", tunes SQLite for production with PRAGMA, and uses ","type":"text"},{"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/Service","isActive":true,"type":"reference"},{"text":" to invalidate an in-process cache on commit.","type":"text"}],"featuredEyebrow":"Tutorial","kind":"callToAction","title":"Expressions and services","action":{"identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/ExpressionsAndServices","isActive":true,"overridingTitle":"Get started","overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"type":"reference"}}],"hierarchy":{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore","modules":[{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/Getting-started","projects":[{"sections":[{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Open-a-database","kind":"task"},{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Define-a-schema","kind":"task"},{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Insert-rows-safely","kind":"task"},{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Query-with-a-stepper","kind":"task"},{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Group-writes-in-a-transaction","kind":"task"},{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Check-Your-Understanding","kind":"assessment"}],"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted"}]},{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/Expressions-and-services","projects":[{"sections":[{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/ExpressionsAndServices#Configure-the-database-for-production","kind":"task"},{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/ExpressionsAndServices#Model-rows-with-Codable","kind":"task"},{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/ExpressionsAndServices#Build-queries-with-ColumnExpression","kind":"task"},{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/ExpressionsAndServices#React-to-commits-with-services","kind":"task"},{"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/ExpressionsAndServices#Check-Your-Understanding","kind":"assessment"}],"reference":"doc:\/\/LoomCore\/tutorials\/LoomCore\/ExpressionsAndServices"}]}],"paths":[["doc:\/\/LoomCore\/tutorials\/LoomCore","doc:\/\/LoomCore\/tutorials\/LoomCore\/$volume","doc:\/\/LoomCore\/tutorials\/LoomCore\/Getting-started"]]},"references":{"doc://LoomCore/tutorials/LoomCore/GettingStarted#Open-a-database":{"type":"section","abstract":[{"type":"text","text":"Build a small notes store: open a database, create a schema, insert rows safely, run queries, and group writes in a transaction. By the end you will have a working command-line app that exercises the core LoomCore API."}],"url":"\/tutorials\/loomcore\/gettingstarted#Open-a-database","title":"Open a database","identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Open-a-database","kind":"section","role":"pseudoSymbol"},"doc://LoomCore/tutorials/LoomCore":{"abstract":[{"text":"Walkthroughs that build small but realistic apps end-to-end. Start with the beginner tutorial to learn the core API; the advanced tutorial covers expression-based queries, custom types, and transaction lifecycle hooks.","type":"text"}],"title":"Build with LoomCore","identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore","type":"topic","role":"overview","kind":"overview","url":"\/tutorials\/loomcore"},"doc://LoomCore/tutorials/LoomCore/GettingStarted":{"type":"topic","abstract":[{"type":"text","text":"Build a small notes store: open a database, create a schema, insert rows safely, run queries, and group writes in a transaction. By the end you will have a working command-line app that exercises the core LoomCore API."}],"url":"\/tutorials\/loomcore\/gettingstarted","title":"Getting started with LoomCore","estimatedTime":"15min","identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted","kind":"project","role":"project"},"gs-07-query.swift":{"fileType":"swift","type":"file","syntax":"swift","content":["import Foundation","import LoomCore","","@main","struct Notes {","    static func main() async throws {","        let db = try await Database.openInMemory()","        \/\/ ... schema and inserts elided ...","","        let notes = try await db.query(\"SELECT id, body FROM notes ORDER BY created_at\") { stmt, _ in","            let id = try Int.column(of: stmt, at: 0)","            let body = try String.column(of: stmt, at: 1)","            return (id, body)","        }","","        for (id, body) in notes {","            print(\"\\(id): \\(body)\")","        }","    }","}"],"highlights":[{"line":8},{"line":10},{"line":11},{"line":12},{"line":13},{"line":15},{"line":16},{"line":17}],"fileName":"main.swift","identifier":"gs-07-query.swift"},"doc://LoomCore/tutorials/LoomCore/Expressions-and-services":{"type":"topic","abstract":[],"url":"\/tutorials\/loomcore\/expressions-and-services","title":"Expressions and services","identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/Expressions-and-services","kind":"article","role":"article"},"doc://LoomCore/documentation/LoomCore/Database/Service":{"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Service","kind":"identifier"}],"abstract":[{"type":"text","text":"Base class for cross-cutting database services that hook into transaction lifecycle events."}],"navigatorTitle":[{"text":"Service","kind":"identifier"}],"url":"\/documentation\/loomcore\/database\/service","title":"Database.Service","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/Service","kind":"symbol","role":"symbol"},"doc://LoomCore/tutorials/LoomCore/ExpressionsAndServices#Check-Your-Understanding":{"titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"url":"\/tutorials\/loomcore\/expressionsandservices#Check-Your-Understanding","title":"Check Your Understanding","type":"link","identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/ExpressionsAndServices#Check-Your-Understanding"},"gs-08-managed.swift":{"fileType":"swift","type":"file","syntax":"swift","content":["import Foundation","import LoomCore","","struct Note {","    let id: Int","    let body: String","    let createdAt: Date","}","","@main","struct Notes {","    static func main() async throws {","        let db = try await Database.openInMemory()","        \/\/ ... schema and inserts elided ...","","        let notes: [Note] = try await db.query(","            raw: \"SELECT id, body, created_at FROM notes ORDER BY created_at\",","            stepper: { stmt, index, _ in","                Note(","                    id: try Int.column(of: stmt, at: &index),","                    body: try String.column(of: stmt, at: &index),","                    createdAt: try Date.column(of: stmt, at: &index)","                )","            }","        )","","        for note in notes {","            print(note)","        }","    }","}"],"highlights":[{"line":4},{"line":5},{"line":6},{"line":7},{"line":8},{"line":9},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":27},{"line":28}],"fileName":"main.swift","identifier":"gs-08-managed.swift"},"doc://LoomCore/tutorials/LoomCore/Getting-started":{"type":"topic","abstract":[],"url":"\/tutorials\/loomcore\/getting-started","title":"Getting started","identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/Getting-started","kind":"article","role":"article"},"gs-04-introspect.swift":{"fileName":"main.swift","content":["import Foundation","import LoomCore","","@main","struct Notes {","    static func main() async throws {","        let db = try await Database.openInMemory()","","        try await db.exec(","            \"\"\"","            CREATE TABLE notes (","              id INTEGER PRIMARY KEY,","              body TEXT NOT NULL,","              created_at REAL NOT NULL","            )","            \"\"\"","        )","","        for column in try await db.tableInfo(\"notes\") {","            print(\"\\(column.name): \\(column.type)\\(column.notNull ? \" NOT NULL\" : \"\")\")","        }","        \/\/ id: INTEGER","        \/\/ body: TEXT NOT NULL","        \/\/ created_at: REAL NOT NULL","    }","}"],"type":"file","syntax":"swift","identifier":"gs-04-introspect.swift","highlights":[{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24}],"fileType":"swift"},"doc://LoomCore/tutorials/LoomCore/GettingStarted#Check-Your-Understanding":{"titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"url":"\/tutorials\/loomcore\/gettingstarted#Check-Your-Understanding","title":"Check Your Understanding","type":"link","identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Check-Your-Understanding"},"gs-05-insert.swift":{"fileName":"main.swift","content":["import Foundation","import LoomCore","","@main","struct Notes {","    static func main() async throws {","        let db = try await Database.openInMemory()","","        try await db.exec(","            \"\"\"","            CREATE TABLE notes (","              id INTEGER PRIMARY KEY,","              body TEXT NOT NULL,","              created_at REAL NOT NULL","            )","            \"\"\"","        )","","        let body = \"Pick up groceries\"","        let createdAt = Date()","        try await db.exec(","            \"INSERT INTO notes (body, created_at) VALUES (\\(body), \\(createdAt))\"","        )","    }","}"],"type":"file","highlights":[{"line":19},{"line":20},{"line":21},{"line":22},{"line":23}],"fileType":"swift","identifier":"gs-05-insert.swift","syntax":"swift"},"doc://LoomCore/tutorials/LoomCore/GettingStarted#Group-writes-in-a-transaction":{"type":"section","role":"pseudoSymbol","title":"Group writes in a transaction","abstract":[{"text":"Build a small notes store: open a database, create a schema, insert rows safely, run queries, and group writes in a transaction. By the end you will have a working command-line app that exercises the core LoomCore API.","type":"text"}],"url":"\/tutorials\/loomcore\/gettingstarted#Group-writes-in-a-transaction","identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Group-writes-in-a-transaction","kind":"section"},"doc://LoomCore/tutorials/LoomCore/ExpressionsAndServices":{"type":"topic","role":"project","title":"Expressions and services","abstract":[{"text":"Build a small task tracker that uses ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/ColumnExpression"},{"text":" and the operator DSL for type-checked queries, stores per-task metadata as JSON via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/JSONBindable"},{"text":", tunes SQLite for production with PRAGMA, and uses ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/Database\/Service"},{"text":" to invalidate an in-process cache on commit.","type":"text"}],"url":"\/tutorials\/loomcore\/expressionsandservices","identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/ExpressionsAndServices","kind":"project","estimatedTime":"25min"},"doc://LoomCore/documentation/LoomCore/ColumnExpression":{"kind":"symbol","type":"topic","title":"ColumnExpression","role":"symbol","abstract":[{"text":"Typed reference to a SQL column, optionally qualified by a table name.","type":"text"}],"identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/ColumnExpression","url":"\/documentation\/loomcore\/columnexpression","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColumnExpression"}],"navigatorTitle":[{"text":"ColumnExpression","kind":"identifier"}]},"gs-06-rowid.swift":{"fileType":"swift","type":"file","syntax":"swift","content":["import Foundation","import LoomCore","","@main","struct Notes {","    static func main() async throws {","        let db = try await Database.openInMemory()","","        try await db.exec(","            \"\"\"","            CREATE TABLE notes (","              id INTEGER PRIMARY KEY,","              body TEXT NOT NULL,","              created_at REAL NOT NULL","            )","            \"\"\"","        )","","        let body = \"Pick up groceries\"","        let createdAt = Date()","        let newID = try await db.lastInsertedRowID {","            try await db.exec(","                \"INSERT INTO notes (body, created_at) VALUES (\\(body), \\(createdAt))\"","            )","        }","        if let newID {","            print(\"Inserted note with id \\(newID)\")","        }","    }","}"],"highlights":[{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26},{"line":27},{"line":28}],"fileName":"main.swift","identifier":"gs-06-rowid.swift"},"doc://LoomCore/tutorials/LoomCore/GettingStarted#Define-a-schema":{"type":"section","role":"pseudoSymbol","title":"Define a schema","abstract":[{"text":"Build a small notes store: open a database, create a schema, insert rows safely, run queries, and group writes in a transaction. By the end you will have a working command-line app that exercises the core LoomCore API.","type":"text"}],"url":"\/tutorials\/loomcore\/gettingstarted#Define-a-schema","identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Define-a-schema","kind":"section"},"doc://LoomCore/tutorials/LoomCore/GettingStarted#Query-with-a-stepper":{"type":"section","role":"pseudoSymbol","title":"Query with a stepper","abstract":[{"text":"Build a small notes store: open a database, create a schema, insert rows safely, run queries, and group writes in a transaction. By the end you will have a working command-line app that exercises the core LoomCore API.","type":"text"}],"url":"\/tutorials\/loomcore\/gettingstarted#Query-with-a-stepper","identifier":"doc:\/\/LoomCore\/tutorials\/LoomCore\/GettingStarted#Query-with-a-stepper","kind":"section"},"doc://LoomCore/tutorials/LoomCore/ExpressionsAndServices#Model-rows-with-Codable":{"abstract":[{"text":"Build a small task tracker that uses ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoomCore\/documentation\/LoomCore\/ColumnExpression"},{"text":" and the operator DSL for type-checked queries, stores per-task metadata as JSON via ","type":"text"},{"isActive":true,"type":"reference","identifier":"d